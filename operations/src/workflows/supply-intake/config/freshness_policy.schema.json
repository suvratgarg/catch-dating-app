{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/operations/supply-intake/freshness_policy.schema.json",
  "title": "SupplyIntakeFreshnessPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "clockSkewToleranceMinutes",
    "kinds"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "clockSkewToleranceMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "kinds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city_discovery_sweep",
        "candidate_verification",
        "known_organizer_event_refresh",
        "event_detail_prepublication"
      ],
      "properties": {
        "city_discovery_sweep": {
          "$ref": "#/definitions/window"
        },
        "candidate_verification": {
          "$ref": "#/definitions/window"
        },
        "known_organizer_event_refresh": {
          "$ref": "#/definitions/window"
        },
        "event_detail_prepublication": {
          "$ref": "#/definitions/window"
        }
      }
    }
  },
  "definitions": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshForHours",
        "description"
      ],
      "properties": {
        "freshForHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    }
  }
}
