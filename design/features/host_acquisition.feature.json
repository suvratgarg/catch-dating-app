          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "initial",
                "interactive-steps",
                "review",
                "submitted",
                "error"
              ]
            }
          ],
          "description": "Returns to the previous application stage while no application submission is pending."
        },
        {
          "id": "toggle_application_choice",
          "owner": "application_controller",
          "codeValue": "toggleDraftList",
          "cardinality": "unbounded",
          "scopeKeys": [
            "formInstanceId",
            "choiceDomain",
            "choiceValue",
            "draftVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "initial",
                "interactive-steps",
                "review",
                "submitted",
                "error"
              ]
            }
          ],
          "description": "Adds or removes a bounded event-format or standalone live-tool choice from the local application draft."
        },
        {
          "id": "submit_host_application",
          "owner": "application_controller",
          "codeValue": "handleSubmit",
          "cardinality": "singleton",
          "scopeKeys": [
            "formInstanceId",
            "submissionVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "initial",
                "interactive-steps",
                "review",
                "submitted",
                "error"
              ]
            },
            {
              "kind": "side_effect",
              "id": "marketing.host_application_submitted"
