{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-10-18",
  "id": "feature.host_acquisition",
  "name": "Host Acquisition",
  "owner": "marketing_website",
  "status": "pilot",
  "description": "Orchestrates the public standalone Host-tooling narrative, external-booking setup and live-tool previews, selective beta application, and post-submission organizer and claim handoffs.",
