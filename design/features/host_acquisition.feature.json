      "actionScope": {
        "included": "Canonical product detail, pilot application navigation, setup and live-stage previews, and Playbook disclosures.",
        "excluded": [
          "Site-header anchors, consent choices, static FAQ/trust content, and capture rendering retain shared shell or presentation ownership.",
          "The static current-versus-coming-later comparison and Host application text/select edits remain presentation or form data governed by their existing owners rather than separate feature actions."
        ]
      },
