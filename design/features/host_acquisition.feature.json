      "actions": [
        {
          "id": "go_to_application_step",
          "owner": "application_controller",
          "codeValue": "goToStep",
          "cardinality": "unbounded",
          "scopeKeys": [
            "formInstanceId",
            "stepId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "initial",
                "interactive-steps",
                "review",
                "submitted",
                "error"
              ]
            }
          ],
          "description": "Moves to a selected application step while no application submission is pending."
        },
        {
          "id": "continue_application",
          "owner": "application_controller",
          "codeValue": "goNext",
          "cardinality": "unbounded",
          "scopeKeys": [
            "formInstanceId",
            "draftVersion",
            "stepId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "initial",
                "interactive-steps",
                "review",
                "submitted",
                "error"
              ]
            }
          ],
          "description": "Validates the current application stage and advances to the next bounded step."
        },
        {
          "id": "back_application",
          "owner": "application_controller",
          "codeValue": "goBack",
          "cardinality": "unbounded",
          "scopeKeys": [
            "formInstanceId",
            "stepId"
