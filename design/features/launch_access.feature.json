{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-08-10",
  "id": "feature.launch_access",
  "name": "Launch Access",
  "owner": "launch_access",
  "status": "active",
  "description": "Orchestrates a member's live city-access application from identity and Firestore loading through editable preferences, bounded submission, review locking, recovery, and approval visibility.",
  "surfaces": [
    {
      "id": "application_flutter",
      "runtime": "flutter",
      "authority": {"registry": "flutter_screens", "id": "screen.launch_access.application"},
      "actionScope": {
        "included": "Retrying identity or application reads, editing the typed launch-access draft, and submitting or updating the current member's Firestore application.",
        "excluded": [
          "Admin review, approval, denial, and audit history remain owned by feature.admin_access_review.",
          "Profile creation after approval remains owned by onboarding and profile features rather than this application route."
        ]
      },
      "bindings": {
        "previewSources": ["widgetbook/lib/utility/p3_utility_use_cases.dart"],
        "actionOwners": [
          {
            "id": "application_screen",
            "language": "dart",
            "file": "lib/launch_access/presentation/launch_access_application_screen.dart",
            "symbol": "LaunchAccessApplicationScreen"
          },
          {
            "id": "application_controller",
            "language": "dart",
            "file": "lib/launch_access/presentation/launch_access_controller.dart",
            "symbol": "LaunchAccessController"
          }
        ],
        "componentContracts": [
          "catch.button",
          "catch.empty_state",
          "catch.error_banner",
          "catch.error_state",
          "catch.field",
          "catch.option_group",
          "catch.skeleton",
          "catch.top_bar"
        ],
        "dataContracts": ["contracts/firestore/access_applications.schema.json"]
      },
      "dimensions": {
        "identity": {"default": "ready", "values": ["loading", "signed_out", "ready"]},
        "application": {"default": "editable", "values": ["loading", "error", "editable", "locked"]},
        "mutation": {"default": "idle", "values": ["idle", "pending"]},
        "connectivity": {"default": "online", "values": ["online", "offline"]},
        "accessibility": {"default": "standard", "values": ["standard", "text_scale_2", "reduced_motion"]}
      },
      "actions": [
        {
          "id": "retry_identity",
          "owner": "application_screen",
          "codeValue": "uidProvider",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "identityLoadGeneration"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["application_loading", "signed_out", "editable_application"]}],
          "description": "Invalidates the current identity provider after an identity-loading failure."
        },
        {
          "id": "retry_application",
          "owner": "application_screen",
          "codeValue": "watchLaunchAccessApplicationProvider",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "applicationLoadGeneration"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["application_loading", "provider_error", "provider_offline", "editable_application", "locked_status"]}],
          "description": "Retries the exact current member's Firestore application stream."
        },
        {
          "id": "select_city",
          "owner": "application_controller",
          "codeValue": "setCity",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "cityMarketId"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Selects one profile-eligible launch city in the typed application draft."
        },
        {
          "id": "select_role",
          "owner": "application_controller",
          "codeValue": "setRole",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "role"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Selects the member, host, or combined participation role."
        },
        {
          "id": "select_event_types",
          "owner": "application_controller",
          "codeValue": "setEventTypes",
          "cardinality": "domain_bounded",
          "scopeKeys": ["routeInstanceId", "eventTypeSet"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Updates the bounded set of event formats the member would attend or host."
        },
        {
          "id": "select_availability",
          "owner": "application_controller",
          "codeValue": "setAvailabilityWindows",
          "cardinality": "domain_bounded",
          "scopeKeys": ["routeInstanceId", "availabilityWindowSet"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Updates the bounded set of preferred availability windows."
        },
        {
          "id": "set_host_interest",
          "owner": "application_controller",
          "codeValue": "setWantsToHost",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "wantsToHost"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Records whether the applicant may also organize events."
        },
        {
          "id": "edit_invite_code",
          "owner": "application_controller",
          "codeValue": "setInviteCode",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "inviteCodeDraft"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Updates the optional invite-code draft under the Firestore field contract."
        },
        {
          "id": "edit_instagram_handle",
          "owner": "application_controller",
          "codeValue": "setInstagramHandle",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "instagramHandleDraft"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Updates the optional Instagram handle draft."
        },
        {
          "id": "edit_referral_source",
          "owner": "application_controller",
          "codeValue": "setReferralSource",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "referralSourceDraft"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Updates the optional referral-source draft."
        },
        {
          "id": "edit_why_catch",
          "owner": "application_controller",
          "codeValue": "setWhyCatch",
          "cardinality": "singleton",
          "scopeKeys": ["routeInstanceId", "whyCatchDraft"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["editable_application"]}],
          "description": "Updates the required explanation used by the launch review queue."
        },
        {
          "id": "submit_application",
          "owner": "application_controller",
          "codeValue": "submit",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "routeInstanceId", "draftVersion"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["submit_application", "editable_application", "locked_status"]}],
          "description": "Validates and transactionally creates or updates the current member's application without weakening a locked review status."
        }
      ],
      "stateIds": [
        "editable_application",
        "application_loading",
        "signed_out",
        "provider_error",
        "provider_offline",
        "locked_status",
        "submit_application",
        "accessibility"
      ],
      "scenarioDefaults": {
        "dimensions": {},
        "actionCases": [{"id": "read_only"}]
      },
      "scenarioOverrides": {
        "editable_application": {
          "dimensions": {"application": "editable"},
          "actionCases": [{
            "id": "draft",
            "enabledActions": ["select_city", "select_role", "select_event_types", "select_availability", "set_host_interest", "edit_invite_code", "edit_instagram_handle", "edit_referral_source", "edit_why_catch", "submit_application"]
          }]
        },
        "application_loading": {
          "dimensions": {"identity": "loading", "application": "loading"},
          "actionCases": [{"id": "identity_retry", "enabledActions": ["retry_identity"]}]
        },
        "signed_out": {
          "dimensions": {"identity": "signed_out"},
          "actionCases": [{"id": "signed_out"}]
        },
        "provider_error": {
          "dimensions": {"application": "error"},
          "actionCases": [{"id": "retry", "enabledActions": ["retry_application"]}]
        },
        "provider_offline": {
          "dimensions": {"application": "error", "connectivity": "offline"},
          "actionCases": [{"id": "retry", "enabledActions": ["retry_application"]}]
        },
        "locked_status": {
          "dimensions": {"application": "locked"},
          "actionCases": [{"id": "locked"}]
        },
        "submit_application": {
          "dimensions": {"application": "editable", "mutation": "pending"},
          "actionCases": [{
            "id": "pending",
            "disabledActions": ["select_city", "select_role", "select_event_types", "select_availability", "set_host_interest", "edit_invite_code", "edit_instagram_handle", "edit_referral_source", "edit_why_catch", "submit_application"]
          }]
        },
        "accessibility": {
          "dimensions": {"application": "editable"},
          "actionCases": [
            {"id": "text_scale", "dimensions": {"accessibility": "text_scale_2"}, "enabledActions": ["select_city", "select_role", "select_event_types", "select_availability", "set_host_interest", "edit_invite_code", "edit_instagram_handle", "edit_referral_source", "edit_why_catch", "submit_application"]},
            {"id": "reduced_motion", "dimensions": {"accessibility": "reduced_motion"}, "enabledActions": ["select_city", "select_role", "select_event_types", "select_availability", "set_host_interest", "edit_invite_code", "edit_instagram_handle", "edit_referral_source", "edit_why_catch", "submit_application"]}
          ]
        }
      },
      "requiredEvidence": {"captures": true, "previews": true, "tests": true}
    }
  ]
}
