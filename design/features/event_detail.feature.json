      "actions": [
        {
          "id": "register_event_with_phone_otp",
          "owner": "event_registration",
          "codeValue": "handleSubmit",
          "cardinality": "singleton",
          "scopeKeys": [
            "routeInstanceId",
            "eventId",
            "verifiedPhoneIdentity"
