{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-09-14",
  "id": "feature.event_detail",
  "name": "Event Detail",
  "owner": "events",
  "status": "pilot",
  "description": "Orchestrates Event Detail across the consumer app, public marketing projection, and exact-location route with explicit state, booking, registration handoff, navigation, directions, and evidence contracts.",
  "surfaces": [
    {
      "id": "consumer_flutter",
      "runtime": "flutter",
      "authority": {
        "registry": "flutter_screens",
        "id": "screen.event.detail"
      },
      "actionScope": {
        "included": "Booking-dock actions represented by EventDetailBookingDockAction, the signed-up member's event-level Cross Paths consent mutation, and opening the exact-location child projection.",
        "excluded": [
          "Navigation chrome, sharing, saving, calendar, companion, organizer, messaging, authentication, and profile-completion actions remain owned and verified by their existing route and widget contracts.",
          "Directions and exact-location child-route recovery belong to the Event Location Map projection below."
        ]
      },
      "bindings": {
        "previewSources": [
          "widgetbook/lib/events/catalog/booking.dart",
          "widgetbook/lib/events/catalog/detail_screen.dart",
          "widgetbook/lib/events/catalog/social.dart",
          "widgetbook/lib/primitives/catalog/celebration.dart",
          "widgetbook/lib/primitives/catalog/chrome.dart",
          "widgetbook/lib/primitives/catalog/docks.dart",
          "widgetbook/lib/primitives/catalog/event_hero.dart",
          "widgetbook/lib/primitives/catalog/event_information.dart",
          "widgetbook/lib/primitives/catalog/feedback.dart",
          "widgetbook/lib/primitives/catalog/inputs.dart",
          "widgetbook/lib/primitives/catalog/layout.dart",
          "widgetbook/lib/primitives/catalog/loading.dart",
          "widgetbook/lib/primitives/catalog/media.dart",
          "widgetbook/lib/primitives/catalog/menus.dart",
          "widgetbook/lib/primitives/catalog/sections.dart",
          "widgetbook/lib/primitives/catalog/typography.dart"
        ],
        "actionOwners": [
          {
            "id": "booking_dock",
            "language": "dart",
            "file": "lib/events/presentation/event_detail_screen_state.dart",
            "symbol": "EventDetailBookingDockAction"
          },
          {
            "id": "event_detail_route",
            "language": "dart",
            "file": "lib/events/presentation/event_detail_screen.dart",
            "symbol": "EventDetailScreen"
          },
          {
            "id": "cross_paths_event_consent",
            "language": "dart",
            "file": "lib/cross_paths/presentation/cross_paths_event_consent_controller.dart",
            "symbol": "CrossPathsEventConsentController"
          }
        ],
        "componentContracts": [
          "catch.async_value",
          "catch.error_state",
          "catch.event_detail_sections"
        ],
        "dataContracts": [
          "contracts/callables/event_booking_payload.schema.json",
          "contracts/client_writes/create_saved_event.schema.json",
          "contracts/client_writes/delete_saved_event.schema.json",
          "contracts/firestore/event_participations.schema.json",
          "contracts/firestore/event_cross_paths_consents.schema.json",
          "contracts/firestore/event_waitlist_offers.schema.json",
          "contracts/firestore/events.schema.json",
          "contracts/firestore/saved_events.schema.json",
          "contracts/callables/set_cross_paths_event_consent_payload.schema.json",
          "contracts/callable_responses/set_cross_paths_event_consent_response.schema.json"
        ]
      },
      "dimensions": {
        "load": {
          "default": "ready",
          "values": [
            "ready",
            "loading",
            "not_found",
            "error",
            "offline"
          ]
        },
        "viewer": {
          "default": "member",
          "values": [
            "guest",
            "member",
            "host"
          ]
        },
        "presentation": {
          "default": "standard",
          "values": [
            "standard",
            "ticket",
            "spotlight_dark"
          ]
        },
        "participation": {
          "default": "eligible",
          "values": [
            "eligible",
            "signed_up",
            "waitlisted",
            "waitlist_offer",
            "full",
            "attended",
            "past",
            "cancelled"
          ]
        },
        "cross_paths_consent": {
          "default": "hidden",
          "values": [
            "hidden",
            "loading",
            "off",
            "on",
            "unavailable"
          ]
        },
        "mutation": {
          "default": "idle",
          "values": [
            "idle",
            "book_pending",
            "cancel_pending",
            "book_failed",
            "cancel_failed",
            "book_succeeded",
            "cancel_succeeded",
            "cross_paths_consent_pending",
            "cross_paths_consent_failed"
          ]
        },
        "accessibility": {
          "default": "standard",
          "values": [
            "standard",
            "text_scale_2",
            "reduced_motion"
          ]
        }
      },
      "actions": [
        {
          "id": "book",
          "owner": "booking_dock",
          "codeValue": "book",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "booking_signed_up"
              ]
            }
          ],
          "description": "Creates at most one active booking relationship for the viewer and event."
        },
        {
          "id": "cancel_booking",
          "owner": "booking_dock",
          "codeValue": "cancelBooking",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "member_default"
              ]
            }
          ],
          "description": "Cancels the viewer's single active booking for the event."
        },
        {
          "id": "join_waitlist",
          "owner": "booking_dock",
          "codeValue": "joinWaitlist",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "waitlist_sold_out_cancelled_past"
              ]
            }
          ],
          "description": "Creates at most one active waitlist relationship for the viewer and event."
        },
        {
          "id": "leave_waitlist",
          "owner": "booking_dock",
          "codeValue": "leaveWaitlist",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "member_default"
              ]
            }
          ],
          "description": "Removes the viewer's single active waitlist relationship for the event."
        },
        {
          "id": "accept_waitlist_offer",
          "owner": "booking_dock",
          "codeValue": "acceptWaitlistOffer",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId",
            "waitlistOfferId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "booking_signed_up"
              ]
            }
          ],
          "description": "Accepts one active waitlist offer and transitions it to a booking."
        },
        {
          "id": "decline_waitlist_offer",
          "owner": "booking_dock",
          "codeValue": "declineWaitlistOffer",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId",
            "waitlistOfferId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "waitlist_sold_out_cancelled_past"
              ]
            }
          ],
          "description": "Declines one active waitlist offer without creating another offer action."
        },
        {
          "id": "set_cross_paths_event_consent",
          "owner": "cross_paths_event_consent",
          "codeValue": "setConsent",
          "cardinality": "singleton",
          "scopeKeys": [
            "viewerUid",
            "eventId",
            "enabled",
            "termsVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "booking_signed_up"
              ]
            }
          ],
          "description": "Updates the caller's deterministic event-consent edge through the App-Check-protected callable; enablement is limited to an opted-in member with a confirmed future booking."
        },
        {
          "id": "open_location_map",
          "owner": "event_detail_route",
          "codeValue": "eventLocationMapScreen",
          "cardinality": "unbounded",
          "scopeKeys": [
            "routeInstanceId",
            "eventId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.event.location_map"
              }
            }
          ],
          "description": "Opens the same event's exact-location map from the always-rendered Where section."
        }
      ],
      "stateIds": [
        "loading",
        "not_found",
        "fatal_error",
        "member_default",
        "member_ticket",
        "member_spotlight_dark",
        "guest",
        "host_app",
        "booking_signed_up",
        "booking_pending",
        "booking_failed",
        "waitlist_sold_out_cancelled_past",
        "offline",
        "text_scale_2",
        "reduced_motion"
      ],
      "scenarioDefaults": {
        "dimensions": {},
        "actionCases": [
          {
            "id": "location_available",
            "enabledActions": [
              "open_location_map"
            ]
          }
        ]
      },
      "scenarioOverrides": {
        "loading": {
          "dimensions": {"load": "loading"},
          "actionCases": [{"id": "default"}]
        },
        "not_found": {
          "dimensions": {"load": "not_found"},
          "actionCases": [{"id": "default"}]
        },
        "fatal_error": {
          "dimensions": {"load": "error"},
          "actionCases": [{"id": "default"}]
        },
        "member_default": {
          "actionCases": [
            {"id": "eligible", "enabledActions": ["book", "open_location_map"]}
          ]
        },
        "member_ticket": {
          "dimensions": {"presentation": "ticket"},
          "actionCases": [
            {"id": "eligible", "enabledActions": ["book", "open_location_map"]}
          ]
        },
        "member_spotlight_dark": {
          "dimensions": {"presentation": "spotlight_dark"},
          "actionCases": [
            {"id": "eligible", "enabledActions": ["book", "open_location_map"]}
          ]
        },
        "guest": {"dimensions": {"viewer": "guest"}},
        "host_app": {"dimensions": {"viewer": "host"}},
        "booking_signed_up": {
          "dimensions": {"participation": "signed_up"},
          "actionCases": [
            {"id": "signed_up", "enabledActions": ["cancel_booking", "open_location_map"]},
            {
              "id": "cross_paths_available_off",
              "dimensions": {"cross_paths_consent": "off"},
              "enabledActions": ["cancel_booking", "set_cross_paths_event_consent", "open_location_map"]
            },
            {
              "id": "cross_paths_available_on",
              "dimensions": {"cross_paths_consent": "on"},
              "enabledActions": ["cancel_booking", "set_cross_paths_event_consent", "open_location_map"]
            },
            {
              "id": "cross_paths_loading",
              "dimensions": {"cross_paths_consent": "loading"},
              "enabledActions": ["cancel_booking", "open_location_map"],
              "disabledActions": ["set_cross_paths_event_consent"]
            },
            {
              "id": "cross_paths_pending",
              "dimensions": {"cross_paths_consent": "off", "mutation": "cross_paths_consent_pending"},
              "enabledActions": ["cancel_booking", "open_location_map"],
              "disabledActions": ["set_cross_paths_event_consent"]
            },
            {
              "id": "cross_paths_unavailable",
              "dimensions": {"cross_paths_consent": "unavailable", "mutation": "cross_paths_consent_failed"},
              "enabledActions": ["cancel_booking", "open_location_map"],
              "disabledActions": ["set_cross_paths_event_consent"]
            }
          ]
        },
        "booking_pending": {
          "actionCases": [
            {
              "id": "book_pending",
              "dimensions": {"mutation": "book_pending"},
              "enabledActions": ["open_location_map"],
              "disabledActions": ["book"]
            },
            {
              "id": "cancel_pending",
              "dimensions": {"participation": "signed_up", "mutation": "cancel_pending"},
              "enabledActions": ["open_location_map"],
              "disabledActions": ["cancel_booking"]
            }
          ]
        },
        "booking_failed": {
          "actionCases": [
            {
              "id": "book_failed",
              "dimensions": {"mutation": "book_failed"},
              "enabledActions": ["book", "open_location_map"]
            },
            {
              "id": "cancel_failed",
              "dimensions": {"participation": "signed_up", "mutation": "cancel_failed"},
              "enabledActions": ["cancel_booking", "open_location_map"]
            },
            {
              "id": "book_succeeded",
              "dimensions": {"participation": "signed_up", "mutation": "book_succeeded"},
              "enabledActions": ["cancel_booking", "open_location_map"]
            },
            {
              "id": "cancel_succeeded",
              "dimensions": {"mutation": "cancel_succeeded"},
              "enabledActions": ["book", "open_location_map"]
            }
          ]
        },
        "waitlist_sold_out_cancelled_past": {
          "actionCases": [
            {
              "id": "waitlisted",
              "dimensions": {"participation": "waitlisted"},
              "enabledActions": ["leave_waitlist", "open_location_map"]
            },
            {
              "id": "waitlist_offer",
              "dimensions": {"participation": "waitlist_offer"},
              "enabledActions": ["accept_waitlist_offer", "decline_waitlist_offer", "open_location_map"]
            },
            {
              "id": "full",
              "dimensions": {"participation": "full"},
              "enabledActions": ["join_waitlist", "open_location_map"]
            },
            {
              "id": "attended",
              "dimensions": {"participation": "attended"},
              "enabledActions": ["open_location_map"]
            },
            {
              "id": "past",
              "dimensions": {"participation": "past"},
              "enabledActions": ["open_location_map"]
            },
            {
              "id": "cancelled",
              "dimensions": {"participation": "cancelled"},
              "enabledActions": ["open_location_map"]
            }
          ]
        },
        "offline": {
          "dimensions": {"load": "offline"},
          "actionCases": [{"id": "default"}]
        },
        "text_scale_2": {
          "dimensions": {"accessibility": "text_scale_2"},
          "actionCases": [
            {"id": "eligible", "enabledActions": ["book", "open_location_map"]}
          ]
        },
        "reduced_motion": {
          "dimensions": {"accessibility": "reduced_motion"},
          "actionCases": [
            {"id": "eligible", "enabledActions": ["book", "open_location_map"]}
          ]
        }
      },
      "requiredEvidence": {
        "captures": true,
        "previews": true,
        "tests": true
      }
    },
    {
      "id": "marketing_web",
      "runtime": "react_marketing",
      "authority": {
        "registry": "marketing_routes",
        "id": "event_detail_canonical"
      },
      "actionScope": {
        "included": "Public Event Detail entry into the authenticated web guest journey, server-resolved admission and booking paths, official external registration sources, and the canonical organizer page. Optional event content and verified event-specific reviews render only when present.",
        "excluded": [
          "Admission, capacity, eligibility and payment authority remain in the existing server-backed guest controllers and repositories. The page composes their sign-in, application, checkout and live-event entry states; organizer claiming belongs to the organizer page, and chat and review submission remain separate flows.",
          "Static path generation, canonical metadata, Event JSON-LD, sitemap inclusion, and missing-event fallback remain owned by the route and postbuild contracts."
        ]
      },
      "bindings": {
        "previewSources": [
          "website/src/stories/MarketingRoutes.stories.tsx",
          "website/src/stories/EventDetailSections.stories.tsx"
