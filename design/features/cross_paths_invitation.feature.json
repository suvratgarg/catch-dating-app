{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-08-06",
  "id": "feature.cross_paths_invitation",
  "name": "Cross Paths Invitation",
  "owner": "cross_paths",
  "status": "pilot",
  "description": "Owns participant-only invitations, organizer-enabled companion holds, canonical checkout conversion, and the temporary event-plan transition without creating a dating match or changing waitlist rank.",
  "surfaces": [
    {
      "id": "consumer_flutter",
      "runtime": "flutter",
      "authority": {
        "registry": "flutter_screens",
        "id": "screen.cross_paths.invitation"
      },
      "actionScope": {
        "included": "Recipient accept/decline, sender pending cancellation, participant hold/plan cancellation, requester companion checkout, and event-plan navigation.",
        "excluded": [
          "Suggestion ranking, consent editing, permanent post-event Catch decisions, waitlist ranking, and organizer event-policy editing retain their owning contracts. Booking and payment execution remain delegated to their canonical authorities."
        ]
      },
      "bindings": {
        "previewSources": [
          "widgetbook/lib/explore/explore_use_cases.dart"
        ],
        "actionOwners": [
          {
            "id": "invitation_mutation",
            "language": "dart",
            "file": "lib/cross_paths/presentation/cross_paths_invitation_controller.dart",
            "symbol": "CrossPathsInvitationController"
          },
          {
            "id": "invitation_route",
            "language": "dart",
            "file": "lib/cross_paths/presentation/cross_paths_invitation_screen.dart",
            "symbol": "CrossPathsInvitationScreen"
          }
        ],
        "componentContracts": [
          "catch.button",
          "catch.person_polaroid",
          "catch.surface",
          "catch.top_bar"
        ],
        "dataContracts": [
          "contracts/firestore/cross_paths_invitations.schema.json",
          "contracts/firestore/cross_paths_pair_holds.schema.json",
          "contracts/firestore/matches.schema.json",
          "contracts/callables/event_booking_payload.schema.json",
          "contracts/callables/create_razorpay_order_payload.schema.json",
          "contracts/callables/create_stripe_checkout_session_payload.schema.json",
          "contracts/callables/respond_cross_paths_invitation_payload.schema.json",
          "contracts/callables/cancel_cross_paths_invitation_or_plan_payload.schema.json",
          "contracts/callable_responses/respond_cross_paths_invitation_response.schema.json",
          "contracts/callable_responses/cancel_cross_paths_invitation_or_plan_response.schema.json"
        ],
        "testEvidence": {
          "invitation_loading": [
            "test/cross_paths/cross_paths_invitation_screen_test.dart"
          ],
          "invitation_unavailable": [
            "test/cross_paths/cross_paths_invitation_screen_test.dart"
          ],
          "invitation_pending": [
            "test/cross_paths/cross_paths_invitation_screen_test.dart",
            "test/cross_paths/cross_paths_invitation_controller_test.dart"
          ],
          "event_plan_accepted": [
            "test/cross_paths/cross_paths_invitation_screen_test.dart",
            "test/chats/chat_screen_test.dart",
            "test/chats/chat_inbox_screen_test.dart"
          ],
          "pair_hold_active": [
            "test/cross_paths/cross_paths_invitation_screen_test.dart",
            "test/cross_paths/cross_paths_invitation_controller_test.dart"
          ],
          "pair_hold_ended": [
            "test/cross_paths/cross_paths_invitation_screen_test.dart",
            "test/cross_paths/cross_paths_contract_test.dart"
          ],
          "invitation_terminal": [
            "test/cross_paths/cross_paths_invitation_screen_test.dart"
          ]
        }
      },
      "dimensions": {
        "load": {
          "default": "ready",
          "values": [
            "ready",
            "loading",
            "unavailable"
          ]
        },
        "lifecycle": {
          "default": "incoming_pending",
          "values": [
            "incoming_pending",
            "outgoing_pending",
            "accepted",
            "pair_held",
            "pair_ended",
            "terminal"
          ]
        }
      },
      "actions": [
        {
          "id": "accept_invitation",
          "owner": "invitation_mutation",
          "codeValue": "respond",
          "cardinality": "singleton",
          "scopeKeys": [
            "invitationId",
            "statusVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "event_plan_accepted",
                "pair_hold_active"
              ]
            }
          ],
          "description": "Recipient accepts one still-pending invitation and creates the deterministic temporary event plan."
        },
        {
          "id": "decline_invitation",
          "owner": "invitation_mutation",
          "codeValue": "respond",
          "cardinality": "singleton",
          "scopeKeys": [
            "invitationId",
            "statusVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "invitation_terminal"
              ]
            }
          ],
          "description": "Recipient declines one pending invitation without creating a conversation."
        },
        {
          "id": "cancel_invitation_or_plan",
          "owner": "invitation_mutation",
          "codeValue": "cancel",
          "cardinality": "singleton",
          "scopeKeys": [
            "invitationId",
            "statusVersion"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "invitation_terminal"
              ]
            }
          ],
          "description": "Sender cancels pending intent or either participant explicitly closes one accepted event plan."
        },
        {
          "id": "complete_pair_booking",
          "owner": "invitation_mutation",
          "codeValue": "completePairBooking",
          "cardinality": "singleton",
          "scopeKeys": [
            "invitationId",
            "pairHoldId"
          ],
          "outcomes": [
            {
              "kind": "surface_state",
              "stateIds": [
                "event_plan_accepted"
              ]
            }
          ],
          "description": "The unbooked requester converts one active companion hold through canonical free or paid booking authority; success confirms participation and creates the event plan."
        },
        {
          "id": "open_event_plan",
          "owner": "invitation_route",
          "codeValue": "pushNamed",
          "cardinality": "unbounded",
          "scopeKeys": [
            "invitationId",
            "conversationId"
          ],
          "outcomes": [
            {
              "kind": "route",
              "authority": {
                "registry": "flutter_screens",
                "id": "screen.matches.chat"
              }
            }
          ],
          "description": "Opens the accepted event-scoped plan without changing invitation, match, booking, or waitlist state."
        }
      ],
      "scenarios": [
        {
          "id": "loading",
          "stateId": "invitation_loading",
          "dimensions": {
            "load": "loading"
          },
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
          "id": "unavailable",
          "stateId": "invitation_unavailable",
          "dimensions": {
            "load": "unavailable"
          },
          "actionCases": [
            {
              "id": "default"
            }
          ]
        },
        {
          "id": "incoming_pending",
          "stateId": "invitation_pending",
          "dimensions": {
            "lifecycle": "incoming_pending"
          },
          "actionCases": [
            {
              "id": "recipient",
              "enabledActions": [
                "accept_invitation",
                "decline_invitation"
              ]
            },
            {
              "id": "sender",
              "dimensions": {
                "lifecycle": "outgoing_pending"
              },
              "enabledActions": [
                "cancel_invitation_or_plan"
              ]
            }
          ]
        },
        {
          "id": "accepted",
          "stateId": "event_plan_accepted",
          "dimensions": {
            "lifecycle": "accepted"
          },
          "actionCases": [
            {
              "id": "participant",
              "enabledActions": [
                "open_event_plan",
                "cancel_invitation_or_plan"
              ]
            }
          ]
        },
        {
          "id": "pair_held",
          "stateId": "pair_hold_active",
          "dimensions": {
            "lifecycle": "pair_held"
          },
          "actionCases": [
            {
              "id": "requester",
              "enabledActions": [
                "complete_pair_booking",
                "cancel_invitation_or_plan"
              ]
            },
            {
              "id": "confirmed_attendee",
              "enabledActions": [
                "cancel_invitation_or_plan"
              ]
            }
          ]
        },
        {
          "id": "pair_ended",
          "stateId": "pair_hold_ended",
          "dimensions": {
            "lifecycle": "pair_ended"
          },
          "actionCases": [
            {
              "id": "read_only"
            }
          ]
        },
        {
          "id": "terminal",
          "stateId": "invitation_terminal",
          "dimensions": {
            "lifecycle": "terminal"
          },
          "actionCases": [
            {
              "id": "read_only"
            }
          ]
        }
      ],
      "requiredEvidence": {
        "captures": false,
        "previews": true,
        "tests": true
      }
    }
  ]
}
