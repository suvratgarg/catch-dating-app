{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-08-05",
  "id": "feature.admin_cross_paths_showcase",
  "name": "Admin Cross Paths Showcase Review",
  "owner": "admin_console",
  "status": "pilot",
  "description": "Orchestrates a bounded, score-free public-profile readiness queue and audited fingerprint-bound showcase decisions.",
  "surfaces": [
    {
      "id": "admin_web",
      "runtime": "react_admin",
      "authority": {
        "registry": "admin_routes",
        "id": "route_cross_paths_showcase"
      },
      "actionScope": {
        "included": "Filtering and paging a bounded public-profile review queue, refreshing current readiness, and recording an audited eligible, needs-review, or paused decision while the complete Admin workspace is frozen.",
        "excluded": [
          "The workflow does not read private Cross Paths consent or attendee relationships.",
          "The workflow does not calculate, store, expose, or infer an attractiveness or desirability score.",
          "Consumer suggestion ranking remains a separate server-side phase."
        ]
      },
      "bindings": {
        "previewSources": ["admin/src/stories/AdminRoutes.stories.tsx"],
        "actionOwners": [
          {
            "id": "controller",
            "language": "typescript",
            "file": "admin/src/features/cross-paths/controllers/useCrossPathsShowcaseController.ts",
            "symbol": "useCrossPathsShowcaseController"
          },
          {
            "id": "screen",
            "language": "typescript",
            "file": "admin/src/features/cross-paths/ui/CrossPathsShowcaseScreen.tsx",
            "symbol": "CrossPathsShowcaseWorkspace"
          }
        ],
        "componentContracts": [
          "route_cross_paths_showcase",
          "workspace_cross_paths_showcase"
        ],
        "dataContracts": [
          "contracts/firestore/cross_paths_showcase_eligibility.schema.json",
          "contracts/callables/admin_list_cross_paths_showcase_candidates_payload.schema.json",
          "contracts/callable_responses/admin_list_cross_paths_showcase_candidates_response.schema.json",
          "contracts/callables/admin_set_cross_paths_showcase_eligibility_payload.schema.json",
          "contracts/callable_responses/admin_set_cross_paths_showcase_eligibility_response.schema.json"
        ],
        "runtimeContracts": [
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminListCrossPathsShowcaseCandidates",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          },
          {
            "kind": "admin_callable",
            "registry": "admin/src/generated/validators/adminCallableValidators.ts",
            "callable": "adminSetCrossPathsShowcaseEligibility",
            "requestValidation": "strict_schema",
            "responseValidation": "strict_schema"
          }
        ],
        "testEvidence": {
          "queue": [
            "admin/src/features/cross-paths/controllers/useCrossPathsShowcaseController.test.tsx"
          ],
          "review-decision": [
            "admin/src/features/cross-paths/controllers/useCrossPathsShowcaseController.test.tsx",
            "admin/src/shared/pendingOperation.test.tsx"
          ]
        }
      },
      "dimensions": {
        "view": {
          "default": "queue",
          "values": ["queue", "loading", "empty", "error"]
        },
        "decision": {
          "default": "idle",
          "values": ["idle", "pending", "failed", "success"]
        }
      },
      "actions": [
        {
          "id": "filter_cross_paths_showcase",
          "owner": "controller",
          "codeValue": "setFilter",
          "cardinality": "domain_bounded",
          "scopeKeys": ["adminSessionId", "effectiveStatus"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["queue"]}],
          "description": "Filters the bounded queue by effective eligibility state."
        },
        {
          "id": "page_cross_paths_showcase",
          "owner": "controller",
          "codeValue": "loadNext",
          "cardinality": "unbounded",
          "scopeKeys": ["adminSessionId", "opaqueCursor"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["queue"]}],
          "description": "Loads the next bounded public-profile page using the server cursor."
        },
        {
          "id": "refresh_cross_paths_showcase",
          "owner": "controller",
          "codeValue": "refresh",
          "cardinality": "singleton",
          "scopeKeys": ["adminSessionId", "queueSnapshotVersion"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["queue"]}],
          "description": "Re-evaluates current public profile readiness and stored review state."
        },
        {
          "id": "decide_cross_paths_showcase",
          "owner": "controller",
          "codeValue": "decide",
          "cardinality": "singleton",
          "scopeKeys": ["reviewerUid", "targetUid", "profileFingerprint", "reviewVersion"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["queue", "review-decision"]},
            {"kind": "side_effect", "id": "admin.cross_paths_showcase_decision_recorded"}
          ],
          "description": "Records an audited review decision bound by the server to the current public profile fingerprint."
        }
      ],
      "scenarios": [
        {
          "id": "queue",
          "stateId": "queue",
          "dimensions": {},
          "actionCases": [
            {
              "id": "ready",
              "enabledActions": [
                "filter_cross_paths_showcase",
                "page_cross_paths_showcase",
                "refresh_cross_paths_showcase",
                "decide_cross_paths_showcase"
              ]
            },
            {
              "id": "loading",
              "dimensions": {"view": "loading"},
              "disabledActions": [
                "filter_cross_paths_showcase",
                "page_cross_paths_showcase",
                "refresh_cross_paths_showcase",
                "decide_cross_paths_showcase"
              ]
            },
            {
              "id": "empty",
              "dimensions": {"view": "empty"},
              "enabledActions": [
                "filter_cross_paths_showcase",
                "refresh_cross_paths_showcase"
              ]
            },
            {
              "id": "error",
              "dimensions": {"view": "error"},
              "enabledActions": ["refresh_cross_paths_showcase"]
            }
          ]
        },
        {
          "id": "review_decision",
          "stateId": "review-decision",
          "dimensions": {},
          "actionCases": [
            {
              "id": "decision_ready",
              "enabledActions": ["decide_cross_paths_showcase"]
            },
            {
              "id": "decision_pending_frozen_workspace",
              "dimensions": {"decision": "pending"},
              "disabledActions": [
                "filter_cross_paths_showcase",
                "page_cross_paths_showcase",
                "refresh_cross_paths_showcase",
                "decide_cross_paths_showcase"
              ]
            }
          ]
        }
      ],
      "requiredEvidence": {
        "captures": false,
        "previews": true,
        "tests": true
      }
    }
  ]
}
