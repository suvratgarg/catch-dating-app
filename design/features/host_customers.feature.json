      "actions": [
        {
          "id": "retry_directory",
          "owner": "customers_screen",
          "codeValue": "invalidate",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "failureStateVersion"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_loading", "customers_populated", "customers_empty"]}],
          "description": "Invalidates the selected organizer directory request after a failed load."
        },
        {
          "id": "switch_organizer",
          "owner": "customers_screen",
          "codeValue": "hostOrganizerSelectionProvider",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "routeInstanceId", "organizerId"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_loading", "customers_populated", "customers_empty"]}],
          "description": "Switches every summary, directory, filter, and detail route input to another hosted organizer."
        },
        {
          "id": "search_customers",
          "owner": "customers_screen",
          "codeValue": "_search",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "query"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_populated", "customers_filtered_empty"]}],
          "description": "Debounces text input before searching the organizer customer directory by normalized display name."
        },
        {
          "id": "open_customer_filters",
          "owner": "customers_screen",
          "codeValue": "HostCustomerFilterSheet",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "query", "activeFilter"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customer_filter_sheet"]}],
          "description": "Opens the grouped Attendance, Reliability, Advocacy, Reachable, and visually distinct Your tags filters with exact-or-qualified counts from listOrganizerContacts."
        },
        {
          "id": "filter_customers",
          "owner": "customers_screen",
          "codeValue": "HostCustomerFilter",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "filter"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_populated", "customers_filtered_empty"]}],
          "description": "Filters the directory by either one server-backed computed segment or one organizer-owned manual tag, never conflating their namespaces or visual treatment."
        },
        {
          "id": "sort_customers",
          "owner": "customers_screen",
          "codeValue": "_sort",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "query", "filter", "sort"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_populated", "customer_sorted_most_attended", "customer_sorted_name"]}],
          "description": "Reloads the complete server-paginated result ordering as Last seen, Most attended, or Name; cursors are bound to the selected ordering."
        },
        {
          "id": "message_filtered_customers",
          "owner": "customers_screen",
          "codeValue": "_messageCustomers",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "filter", "matchCountCoverage"],
          "outcomes": [{"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.host.inbox"}}],
          "description": "Routes an eligible active-sender segment into the Messaging Campaigns composer with that segment preselected; otherwise keeps the control disabled beside its campaign blocker reason."
        },
        {
          "id": "load_more",
          "owner": "customers_directory",
          "codeValue": "loadMore",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "query", "filter", "sort", "cursor"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_paginating", "customers_populated"]}],
          "description": "Loads and contact-id de-duplicates the next server page for the active query."
        },
        {
          "id": "export_customers",
          "owner": "customers_mutations",
          "codeValue": "exportCustomers",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "filter", "exportAttemptId"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_export_pending", "customers_populated"]},
            {"kind": "side_effect", "id": "host_customers.export_shared"}
          ],
          "description": "Exports the active server-backed customer segment as CSV and opens the native share surface."
        },
        {
          "id": "create_customer",
          "owner": "customers_mutations",
          "codeValue": "createCustomer",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "submitAttemptId"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["manual_add_pending", "customers_populated"]},
            {"kind": "side_effect", "id": "host_customers.organizer_contact_created"}
          ],
          "description": "Creates an organizer CRM contact with a required name, optional unverified phone/email evidence, and an optional private note without creating a Catch identity or granting messaging permission."
        },
        {
          "id": "open_customer",
          "owner": "customers_screen",
          "codeValue": "_openCustomer",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "contactId"],
          "outcomes": [{"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.host.customers"}}],
          "description": "Opens the nested route-level customer detail surface for the selected contact."
        },
        {
          "id": "open_customer_event",
          "owner": "customer_detail",
          "codeValue": "pushNamed",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "eventId"],
          "outcomes": [{"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.event.detail"}}],
          "description": "Opens the host event detail route from one customer event-history row."
        },
        {
          "id": "manage_customer",
          "owner": "customers_mutations",
          "codeValue": "mutateCustomer",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "expectedRevision", "mutation"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_manage_pending", "customers_populated"]},
            {"kind": "side_effect", "id": "host_customers.contact_updated"}
          ],
          "description": "Renames, pauses or resumes WhatsApp, or removes a customer using revision-checked server mutations."
        },
        {
          "id": "review_duplicate_customers",
          "owner": "customers_screen",
          "codeValue": "_reviewDuplicates",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "reviewSessionId"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customer_merge_review", "customer_merge_dismissed"]}],
          "description": "Lists only exact verified or proposed phone/email duplicate candidates, with derived evidence and no name-only inference."
        },
        {
          "id": "decide_duplicate_customer",
          "owner": "customer_merge_review",
          "codeValue": "_merge",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "candidateId", "decision", "survivorContactId", "expectedRevisions"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_merge_review", "customer_merge_dismissed", "customer_merge_conflict_confirmation"]},
            {"kind": "side_effect", "id": "host_customers.merge_review_decided"}
          ],
          "description": "Requires an explicit survivor for merge, confirms contradictory identity facts, or durably records and same-manager reopens Different people."
        },
        {
          "id": "undo_customer_merge",
          "owner": "customer_detail",
          "codeValue": "_undoMerge",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "mergeReceiptId"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_active_merges", "customer_unmerge_pending"]},
            {"kind": "side_effect", "id": "host_customers.merge_reversed"}
          ],
          "description": "Reverses one selected active merge receipt from the survivor detail screen and refreshes the customer directory."
        },
        {
          "id": "edit_contact_tags",
          "owner": "customer_memory",
          "codeValue": "HostCustomerTagsSheet",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "expectedRevision"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_tags_editing", "customer_memory_populated"]},
            {"kind": "side_effect", "id": "host_customers.manual_tags_updated"}
          ],
          "description": "Assigns up to five labels from an organizer vocabulary capped at twenty through mutateOrganizerContact."
        },
        {
          "id": "create_contact_note",
          "owner": "customer_memory",
          "codeValue": "createNote",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "submitAttemptId"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_note_editing", "customer_memory_populated"]},
            {"kind": "side_effect", "id": "host_customers.contact_note_created"}
          ],
          "description": "Appends an organizer-scoped, author-stamped note without adding it to contact export."
        },
        {
          "id": "edit_contact_note",
          "owner": "customer_memory",
          "codeValue": "editNote",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "noteId", "expectedRevision"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_note_editing", "customer_memory_populated"]},
            {"kind": "side_effect", "id": "host_customers.contact_note_updated"}
          ],
          "description": "Optimistically edits one note body while preserving its original author stamp."
        },
        {
          "id": "retry_customer_detail",
          "owner": "customer_detail",
          "codeValue": "invalidate",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "failureStateVersion"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customer_detail_loading", "customer_detail_linked", "customer_detail_unlinked"]}],
          "description": "Invalidates only the failed organizer-contact detail request."
        },
        {
          "id": "start_conversation",
          "owner": "customers_mutations",
          "codeValue": "startConversation",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "tapAttemptId"],
          "outcomes": [
            {"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.host.chat"}},
            {"kind": "side_effect", "id": "host_customers.direct_conversation_started"}
          ],
          "description": "Starts or reuses a manager-authorized direct thread only for an unambiguous verified linked Catch account."
        },
        {
          "id": "open_personal_whatsapp_handoff",
          "owner": "customer_detail",
          "codeValue": "_openWhatsapp",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "phoneE164", "tapAttemptId"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["personal_whatsapp_handoff"]},
            {"kind": "side_effect", "id": "host_customers.whatsapp_app_launched"}
          ],
          "description": "Opens an editable prefilled native WhatsApp app handoff, with wa.me fallback, for one valid contact phone only while no explicit WhatsApp opt-out or admin suppression applies. The Host remains responsible for pressing Send in WhatsApp, and Catch records no delivery or reply receipt."
        }
      ],
      "stateIds": ["customers_loading", "customers_error", "customers_empty", "customers_populated", "customers_filtered_empty", "customers_paginating", "customer_sorted_most_attended", "customer_sorted_name", "customer_filter_sheet", "customer_filter_manual_tag", "customer_campaign_bridge_ready", "customer_campaign_bridge_blocked", "manual_add_pending", "customer_export_pending", "customer_manage", "customer_manage_pending", "customer_detail_loading", "customer_detail_error", "customer_detail_linked", "customer_detail_unlinked", "customer_detail_ambiguous", "customer_memory_populated", "customer_note_editing", "customer_tags_editing", "customer_send_history", "customer_merge_review", "customer_merge_dismissed", "customer_merge_conflict_confirmation", "customer_active_merges", "customer_unmerge_pending", "customer_revenue_exact", "customer_revenue_partial", "customer_revenue_unavailable", "conversation_available", "conversation_unavailable", "personal_whatsapp_unavailable", "personal_whatsapp_handoff", "offline", "text_scale_2", "reduced_motion", "light_dark"],
