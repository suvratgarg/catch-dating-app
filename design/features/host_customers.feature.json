{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-08-18",
  "id": "feature.host_customers",
  "name": "Host Customers",
  "owner": "hosts",
  "status": "active",
  "description": "Makes Customers the sole Host CRM directory for server-backed sorting, computed segments, organizer-authored notes and tags, per-person campaign and Announcement history, reviewed identity merges and reversals, contact administration, customer detail, identity-gated Catch chat, personal WhatsApp handoff, and a deep-linked segment bridge into Messaging campaigns.",
  "surfaces": [
    {
      "id": "host_flutter",
      "runtime": "flutter",
      "authority": {"registry": "flutter_screens", "id": "screen.host.customers"},
      "actionScope": {
        "included": "Customer directory recovery, shared organizer selection, debounced name search, server-backed Last seen, Most attended, and Name sorting with ordering-bound cursors, exact-or-qualified result counts, grouped computed-segment and organizer-tag filters, pagination, header-menu export excluding notes, organizer-only manual contact creation, private author-stamped note append/edit, bounded manual-tag vocabulary assignment, per-person Campaign and Announcement delivery history, evidence-bearing manager merge review with durable Different people decisions, receipt-specific unmerge from survivor detail, rename/suppression/removal controls, complete event evidence, customer and event detail routing, verified-account Catch chat creation, editable personal WhatsApp app handoff for contacts with a valid phone, and routing only an eligible computed segment into the Messaging campaign composer.",
        "excluded": [
          "High-spender segmentation remains excluded until completed non-refunded payment totals are projected into indexed organizer-contact traits."
        ]
      },
      "bindings": {
        "previewSources": ["widgetbook/lib/hosts/host_operations_use_cases.dart"],
