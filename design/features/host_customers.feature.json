{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-08-15",
  "id": "feature.host_customers",
  "name": "Host Customers",
  "owner": "hosts",
  "status": "active",
  "description": "Makes Customers the sole Host CRM destination for the complete audience segment set, pagination, export, contact administration, customer detail, and identity-gated conversations.",
  "surfaces": [
    {
      "id": "host_flutter",
      "runtime": "flutter",
      "authority": {"registry": "flutter_screens", "id": "screen.host.customers"},
      "actionScope": {
        "included": "Customer directory recovery, shared organizer selection, debounced name search, readiness-visible server-backed CRM segments, pagination, header-menu export, organizer-only manual contact creation, rename/suppression/removal controls, complete event evidence, customer and event detail routing, and verified-account direct conversation creation.",
        "excluded": [
          "Merge and unmerge controls remain backend-only until a reviewed conflict-resolution UI exists; the deprecated Audience tab did not expose them.",
          "High-spender segmentation remains excluded until completed non-refunded payment totals are projected into indexed organizer-contact traits."
        ]
      },
      "bindings": {
        "previewSources": ["widgetbook/lib/hosts/host_operations_use_cases.dart"],
        "actionOwners": [
          {"id": "customers_screen", "language": "dart", "file": "lib/hosts/presentation/customers/host_customers_screen.dart", "symbol": "HostCustomersScreen"},
          {"id": "customers_directory", "language": "dart", "file": "lib/hosts/presentation/customers/host_customers_controller.dart", "symbol": "HostCustomersDirectoryController"},
          {"id": "customers_mutations", "language": "dart", "file": "lib/hosts/presentation/customers/host_customers_controller.dart", "symbol": "HostCustomersController"},
          {"id": "customer_detail", "language": "dart", "file": "lib/hosts/presentation/customers/host_customer_detail_screen.dart", "symbol": "HostCustomerDetailScreen"}
        ],
        "componentContracts": ["catch.button", "catch.chip", "catch.empty_state", "catch.error_state", "catch.field", "catch.notice", "catch.option_group", "catch.person_row", "catch.search_field", "catch.section", "catch.skeleton", "catch.surface", "catch.top_bar"],
        "dataContracts": [
          "contracts/callable_responses/create_organizer_contact_response.schema.json",
          "contracts/callable_responses/export_organizer_contacts_response.schema.json",
          "contracts/callable_responses/get_organizer_contact_detail_response.schema.json",
          "contracts/callable_responses/list_organizer_contacts_response.schema.json",
          "contracts/callable_responses/mutate_organizer_contact_response.schema.json",
          "contracts/callables/create_organizer_contact_payload.schema.json",
          "contracts/callables/export_organizer_contacts_payload.schema.json",
          "contracts/callables/get_organizer_contact_detail_payload.schema.json",
          "contracts/callables/list_organizer_contacts_payload.schema.json",
          "contracts/callables/mutate_organizer_contact_payload.schema.json",
          "contracts/callables/start_organizer_contact_conversation_payload.schema.json",
          "contracts/firestore/organizer_contact_channel_states.schema.json",
          "contracts/firestore/organizer_contact_event_edges.schema.json",
          "contracts/firestore/organizer_contact_traits.schema.json",
          "contracts/firestore/organizer_contacts.schema.json",
          "contracts/firestore/payments.schema.json"
        ],
        "testEvidence": {
          "customers_populated": ["test/hosts/host_customers_screen_state_test.dart", "test/routing/host_shell_navigation_test.dart", "test/routing/router_redirect_test.dart"],
          "customers_filtered_empty": ["test/hosts/host_customers_screen_state_test.dart"],
          "customer_detail_linked": ["test/hosts/host_crm_repository_test.dart", "test/hosts/host_customers_screen_state_test.dart"],
          "customer_detail_unlinked": ["test/hosts/host_customers_screen_state_test.dart"],
          "customer_detail_ambiguous": ["test/hosts/host_customers_screen_state_test.dart"],
          "customer_revenue_exact": ["test/hosts/host_crm_repository_test.dart"],
          "conversation_available": ["test/hosts/host_customers_screen_state_test.dart"],
          "conversation_unavailable": ["test/hosts/host_customers_screen_state_test.dart"],
          "customer_manage": ["test/hosts/host_customers_screen_state_test.dart"]
        }
      },
      "dimensions": {
        "load": {"default": "ready", "values": ["ready", "loading", "error", "offline"]},
        "directory": {"default": "populated", "values": ["populated", "empty", "filtered_empty", "paginating"]},
        "identity": {"default": "linked", "values": ["linked", "unlinked", "ambiguous"]},
        "revenue": {"default": "exact", "values": ["exact", "partial", "unavailable"]},
        "mutation": {"default": "idle", "values": ["idle", "adding", "exporting", "managing_contact", "starting_conversation"]},
        "accessibility": {"default": "standard", "values": ["standard", "text_scale_2", "reduced_motion"]},
        "theme": {"default": "standard", "values": ["standard", "light_dark"]}
      },
      "actions": [
        {
          "id": "retry_directory",
          "owner": "customers_screen",
          "codeValue": "invalidate",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "failureStateVersion"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_loading", "customers_populated", "customers_empty"]}],
          "description": "Invalidates the selected organizer directory request after a failed load."
        },
        {
          "id": "switch_organizer",
          "owner": "customers_screen",
          "codeValue": "hostOrganizerSelectionProvider",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "routeInstanceId", "organizerId"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_loading", "customers_populated", "customers_empty"]}],
          "description": "Switches every summary, directory, filter, and detail route input to another hosted organizer."
        },
        {
          "id": "search_customers",
          "owner": "customers_screen",
          "codeValue": "_search",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "query"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_populated", "customers_filtered_empty"]}],
          "description": "Debounces text input before searching the organizer customer directory by normalized display name."
        },
        {
          "id": "filter_customers",
          "owner": "customers_screen",
          "codeValue": "HostCustomerFilter",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "filter"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_populated", "customers_filtered_empty"]}],
          "description": "Filters the directory by server-backed versioned lifecycle traits visible for the current CRM channel readiness, including an explainable At risk alias for lapsed regulars."
        },
        {
          "id": "load_more",
          "owner": "customers_directory",
          "codeValue": "loadMore",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "query", "filter", "cursor"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customers_paginating", "customers_populated"]}],
          "description": "Loads and contact-id de-duplicates the next server page for the active query."
        },
        {
          "id": "export_customers",
          "owner": "customers_mutations",
          "codeValue": "exportCustomers",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "filter", "exportAttemptId"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_export_pending", "customers_populated"]},
            {"kind": "side_effect", "id": "host_customers.export_shared"}
          ],
          "description": "Exports the active server-backed customer segment as CSV and opens the native share surface."
        },
        {
          "id": "create_customer",
          "owner": "customers_mutations",
          "codeValue": "createCustomer",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "submitAttemptId"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["manual_add_pending", "customers_populated"]},
            {"kind": "side_effect", "id": "host_customers.organizer_contact_created"}
          ],
          "description": "Creates a name-only organizer CRM contact without creating a Catch identity or granting messaging permission."
        },
        {
          "id": "open_customer",
          "owner": "customers_screen",
          "codeValue": "_openCustomer",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "contactId"],
          "outcomes": [{"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.host.customers"}}],
          "description": "Opens the nested route-level customer detail surface for the selected contact."
        },
        {
          "id": "open_customer_event",
          "owner": "customer_detail",
          "codeValue": "pushNamed",
          "cardinality": "unbounded",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "eventId"],
          "outcomes": [{"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.event.detail"}}],
          "description": "Opens the host event detail route from one customer event-history row."
        },
        {
          "id": "manage_customer",
          "owner": "customers_mutations",
          "codeValue": "mutateCustomer",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "expectedRevision", "mutation"],
          "outcomes": [
            {"kind": "surface_state", "stateIds": ["customer_manage_pending", "customers_populated"]},
            {"kind": "side_effect", "id": "host_customers.contact_updated"}
          ],
          "description": "Renames, pauses or resumes WhatsApp, or removes a customer using revision-checked server mutations."
        },
        {
          "id": "retry_customer_detail",
          "owner": "customer_detail",
          "codeValue": "invalidate",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "failureStateVersion"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["customer_detail_loading", "customer_detail_linked", "customer_detail_unlinked"]}],
          "description": "Invalidates only the failed organizer-contact detail request."
        },
        {
          "id": "start_conversation",
          "owner": "customers_mutations",
          "codeValue": "startConversation",
          "cardinality": "singleton",
          "scopeKeys": ["viewerUid", "organizerId", "contactId", "tapAttemptId"],
          "outcomes": [
            {"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.host.chat"}},
            {"kind": "side_effect", "id": "host_customers.direct_conversation_started"}
          ],
          "description": "Starts or reuses a manager-authorized direct thread only for an unambiguous verified linked Catch account."
        }
      ],
      "stateIds": ["customers_loading", "customers_error", "customers_empty", "customers_populated", "customers_filtered_empty", "customers_paginating", "manual_add_pending", "customer_export_pending", "customer_manage", "customer_manage_pending", "customer_detail_loading", "customer_detail_error", "customer_detail_linked", "customer_detail_unlinked", "customer_detail_ambiguous", "customer_revenue_exact", "customer_revenue_partial", "customer_revenue_unavailable", "conversation_available", "conversation_unavailable", "offline", "text_scale_2", "reduced_motion", "light_dark"],
      "scenarioDefaults": {"dimensions": {}, "actionCases": [{"id": "default"}]},
      "scenarioOverrides": {
        "customers_loading": {"dimensions": {"load": "loading"}},
        "customers_error": {"dimensions": {"load": "error"}, "actionCases": [{"id": "recovery", "enabledActions": ["retry_directory"]}]},
        "customers_empty": {"dimensions": {"directory": "empty"}, "actionCases": [{"id": "first_customer", "enabledActions": ["switch_organizer", "create_customer"]}]},
        "customers_populated": {"actionCases": [{"id": "directory", "enabledActions": ["switch_organizer", "search_customers", "filter_customers", "load_more", "export_customers", "create_customer", "open_customer", "manage_customer"]}]},
        "customers_filtered_empty": {"dimensions": {"directory": "filtered_empty"}, "actionCases": [{"id": "adjust", "enabledActions": ["search_customers", "filter_customers"]}]},
        "customers_paginating": {"dimensions": {"directory": "paginating"}, "actionCases": [{"id": "pending", "disabledActions": ["load_more"]}]},
        "manual_add_pending": {"dimensions": {"mutation": "adding"}, "actionCases": [{"id": "pending", "disabledActions": ["create_customer"]}]},
        "customer_export_pending": {"dimensions": {"mutation": "exporting"}, "actionCases": [{"id": "pending", "disabledActions": ["export_customers"]}]},
        "customer_manage": {"actionCases": [{"id": "manage", "enabledActions": ["manage_customer"]}]},
        "customer_manage_pending": {"dimensions": {"mutation": "managing_contact"}, "actionCases": [{"id": "pending", "disabledActions": ["manage_customer"]}]},
        "customer_detail_loading": {"dimensions": {"load": "loading"}},
        "customer_detail_error": {"dimensions": {"load": "error"}, "actionCases": [{"id": "recovery", "enabledActions": ["retry_customer_detail"]}]},
        "customer_detail_linked": {"dimensions": {"identity": "linked"}, "actionCases": [{"id": "linked", "enabledActions": ["start_conversation", "open_customer_event"]}]},
        "customer_detail_unlinked": {"dimensions": {"identity": "unlinked"}, "actionCases": [{"id": "unlinked", "enabledActions": ["open_customer_event"], "disabledActions": ["start_conversation"]}]},
        "customer_detail_ambiguous": {"dimensions": {"identity": "ambiguous"}, "actionCases": [{"id": "ambiguous", "enabledActions": ["open_customer_event"], "disabledActions": ["start_conversation"]}]},
        "customer_revenue_exact": {"dimensions": {"revenue": "exact"}},
        "customer_revenue_partial": {"dimensions": {"revenue": "partial"}},
        "customer_revenue_unavailable": {"dimensions": {"revenue": "unavailable"}},
        "conversation_available": {"dimensions": {"identity": "linked"}, "actionCases": [{"id": "start", "enabledActions": ["start_conversation"]}]},
        "conversation_unavailable": {"dimensions": {"identity": "unlinked"}, "actionCases": [{"id": "blocked", "disabledActions": ["start_conversation"]}]},
        "offline": {"dimensions": {"load": "offline"}, "actionCases": [{"id": "retry", "enabledActions": ["retry_directory", "retry_customer_detail"]}]},
        "text_scale_2": {"dimensions": {"accessibility": "text_scale_2"}},
        "reduced_motion": {"dimensions": {"accessibility": "reduced_motion"}},
        "light_dark": {"dimensions": {"theme": "light_dark"}}
      },
      "requiredEvidence": {"captures": false, "previews": true, "tests": true},
      "evidenceExceptions": [
        {
          "stateIds": ["customers_loading", "customers_error", "customers_empty", "customers_paginating", "manual_add_pending", "customer_export_pending", "customer_manage_pending", "customer_detail_loading", "customer_detail_error", "customer_revenue_partial", "customer_revenue_unavailable", "offline", "text_scale_2", "reduced_motion", "light_dark"],
          "evidence": ["tests"],
          "debtId": "HOST-CUSTOMERS-EVIDENCE-001",
          "reason": "Controller policy, repository mapping, and route tests cover the initial seam; deterministic rendered state tests remain follow-up evidence for the customer directory."
        },
        {
          "stateIds": ["customers_loading", "customers_error", "customers_empty", "customers_filtered_empty", "customers_paginating", "manual_add_pending", "customer_export_pending", "customer_manage", "customer_manage_pending", "customer_detail_loading", "customer_detail_error", "customer_detail_unlinked", "customer_detail_ambiguous", "customer_revenue_partial", "customer_revenue_unavailable", "conversation_unavailable", "offline", "text_scale_2", "reduced_motion", "light_dark"],
          "evidence": ["previews"],
          "debtId": "HOST-CUSTOMERS-EVIDENCE-001",
          "reason": "The initial Widgetbook gallery covers the populated directory and linked exact-revenue detail; remaining recovery, identity, coverage, accessibility, and theme variants are explicit preview debt."
        }
      ]
    }
  ]
}
