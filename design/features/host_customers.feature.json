        "directory": {"default": "populated", "values": ["populated", "empty", "filtered_empty", "paginating"]},
        "sort": {"default": "last_seen", "values": ["last_seen", "most_attended", "name"]},
        "filter_sheet": {"default": "closed", "values": ["closed", "open"]},
        "merge_review": {"default": "closed", "values": ["closed", "candidates", "dismissed", "conflict_confirmation", "active_receipts", "undoing"]},
        "notes": {"default": "populated", "values": ["populated", "empty", "truncated", "editing"]},
        "tags": {"default": "assigned", "values": ["assigned", "empty", "editing"]},
        "campaign_bridge": {"default": "blocked", "values": ["blocked", "ready"]},
        "identity": {"default": "linked", "values": ["linked", "unlinked", "ambiguous"]},
        "revenue": {"default": "exact", "values": ["exact", "partial", "unavailable"]},
        "personal_whatsapp": {"default": "ready", "values": ["unavailable", "ready", "editing", "opening"]},
