{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-09-04",
  "id": "feature.event_rehearsal",
  "name": "Event Dress Rehearsal",
  "owner": "event_rehearsal",
  "status": "active",
  "description": "Orchestrates an isolated Host practice copy and anonymous guest phone across preparation, virtual live operations, issue simulation, completion, replay, and reproduction export without mutating the production event domain.",
  "surfaces": [
    {
      "id": "host_flutter",
      "runtime": "flutter",
      "authority": {"registry": "flutter_screens", "id": "screen.host.event.rehearsal"},
      "actionScope": {
        "included": "Creating from organizer defaults or an upcoming event with an explicit guest source, optional configuration before starting, controlling virtual time and lifecycle, simulating actor behavior and gated internal faults, rotating and sharing the guest link, resetting or forking a deterministic run, and exporting a reproduction.",
        "excluded": [
          "Production event editing, attendance, messaging, payments, matching, booking, and Event Success writes remain outside the rehearsal domain.",
          "Selecting a menu row, scrolling the roster, and expanding field affordances are UI mechanics rather than additional product actions.",
          "Automatic polling and projection invalidation are read lifecycle effects; explicit retry remains an action."
        ]
      },
      "bindings": {
        "previewSources": [],
        "actionOwners": [
          {
            "id": "rehearsal_controller",
            "language": "dart",
            "file": "lib/event_rehearsal/presentation/event_rehearsal_controller.dart",
            "symbol": "EventRehearsalController"
          },
          {
            "id": "rehearsal_console",
            "language": "dart",
            "file": "lib/event_rehearsal/presentation/host_event_rehearsal_screen.dart",
            "symbol": "HostEventRehearsalScreen"
          }
        ],
        "componentContracts": [
          "catch.button",
          "catch.error_state",
          "catch.field",
          "catch.menu",
          "catch.surface",
          "catch.top_bar"
        ],
        "dataContracts": [
          "contracts/callables/control_event_rehearsal_payload.schema.json",
          "contracts/callables/create_event_rehearsal_payload.schema.json",
          "contracts/callables/get_event_rehearsal_bootstrap_payload.schema.json",
          "contracts/callables/inject_event_rehearsal_behavior_payload.schema.json",
          "contracts/callables/reset_event_rehearsal_payload.schema.json",
          "contracts/callables/rotate_event_rehearsal_guest_link_payload.schema.json",
          "contracts/callables/update_event_rehearsal_setup_payload.schema.json",
          "contracts/callable_responses/create_event_rehearsal_response.schema.json",
          "contracts/callable_responses/event_rehearsal_bootstrap_response.schema.json",
          "contracts/callable_responses/event_rehearsal_reproduction_response.schema.json",
          "contracts/firestore/event_rehearsal_actions.schema.json",
          "contracts/firestore/event_rehearsal_actors.schema.json",
          "contracts/firestore/event_rehearsal_guest_views.schema.json",
          "contracts/firestore/event_rehearsals.schema.json"
        ],
        "testEvidence": {
          "host_event_rehearsal_start": ["test/event_rehearsal/host_event_rehearsal_screen_test.dart"],
          "host_event_rehearsal_loading": ["test/event_rehearsal/host_event_rehearsal_screen_test.dart"],
          "host_event_rehearsal_error": ["test/event_rehearsal/host_event_rehearsal_screen_test.dart"],
          "host_event_rehearsal_setup": ["test/event_rehearsal/event_rehearsal_domain_test.dart"],
          "host_event_rehearsal_running": ["test/event_rehearsal/host_event_rehearsal_screen_test.dart"],
          "host_event_rehearsal_paused": ["test/event_rehearsal/event_rehearsal_domain_test.dart"],
          "host_event_rehearsal_complete": ["test/event_rehearsal/event_rehearsal_domain_test.dart"],
          "host_event_rehearsal_mutation": ["test/event_rehearsal/host_event_rehearsal_screen_test.dart"]
        }
      },
      "dimensions": {
        "lifecycle": {"default": "draft", "values": ["draft", "ready", "running", "paused", "complete"]},
        "mutation": {"default": "idle", "values": ["idle", "pending", "failed"]},
        "projection": {"default": "ready", "values": ["loading", "ready", "error"]}
      },
      "actions": [
        {
          "id": "create_rehearsal",
          "owner": "rehearsal_controller",
          "codeValue": "create",
          "cardinality": "singleton",
          "scopeKeys": ["organizerId", "sourceEventId", "seed"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["host_event_rehearsal_setup", "host_event_rehearsal_running"]}],
          "description": "Creates the configured practice copy and opens the existing runtime directly; legacy clients may still create a draft."
        },
        {
          "id": "retry_rehearsal_projection",
          "owner": "rehearsal_console",
          "codeValue": "invalidate",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "loadGeneration"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["host_event_rehearsal_loading", "host_event_rehearsal_error", "host_event_rehearsal_setup", "host_event_rehearsal_running", "host_event_rehearsal_paused", "host_event_rehearsal_complete"]}],
          "description": "Retries the isolated bootstrap projection without changing rehearsal state."
        },
        {
          "id": "update_rehearsal_setup",
          "owner": "rehearsal_controller",
          "codeValue": "updateSetup",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "setupRevision"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["host_event_rehearsal_setup"]}],
          "description": "Saves event details, playbook modules, scenario, and synthetic actor count before the run starts."
        },
        {
          "id": "control_virtual_event",
          "owner": "rehearsal_controller",
          "codeValue": "control",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "runtimeRevision", "clientActionId"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["host_event_rehearsal_setup", "host_event_rehearsal_running", "host_event_rehearsal_paused", "host_event_rehearsal_complete"]}],
          "description": "Marks ready, starts, pauses, resumes, moves playbook steps, advances virtual time, or completes the run."
        },
        {
          "id": "simulate_rehearsal_issue",
          "owner": "rehearsal_controller",
          "codeValue": "inject",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "runtimeRevision", "clientActionId"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["host_event_rehearsal_running", "host_event_rehearsal_paused"]}],
          "description": "Injects late arrival, no-show, early exit, return, walk-in, ambiguous claim, opt-out, keep-apart, disconnect, recovery, or a gated internal fault."
        },
        {
          "id": "rotate_guest_link",
          "owner": "rehearsal_controller",
          "codeValue": "rotateGuestLink",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "guestLinkGeneration"],
          "outcomes": [{"kind": "side_effect", "id": "event_rehearsal.guest_link_rotated"}],
          "description": "Invalidates every prior public rehearsal link and issues a new high-entropy guest link."
        },
        {
          "id": "copy_guest_link",
          "owner": "rehearsal_controller",
          "codeValue": "copyGuestLink",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "guestLinkGeneration"],
          "outcomes": [{"kind": "side_effect", "id": "clipboard.rehearsal_guest_link_copied"}],
          "description": "Copies the current anonymous guest-phone URL."
        },
        {
          "id": "share_guest_link",
          "owner": "rehearsal_controller",
          "codeValue": "shareGuestLink",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "guestLinkGeneration"],
          "outcomes": [{"kind": "side_effect", "id": "share.rehearsal_guest_link_opened"}],
          "description": "Opens the platform share sheet with the current guest-phone URL."
        },
        {
          "id": "reset_rehearsal",
          "owner": "rehearsal_controller",
          "codeValue": "reset",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "seed", "resetGeneration"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["host_event_rehearsal_setup"]}],
          "description": "Restores the same deterministic room to its initial setup and actor state."
        },
        {
          "id": "fork_rehearsal",
          "owner": "rehearsal_controller",
          "codeValue": "fork",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "seed", "forkGeneration"],
          "outcomes": [{"kind": "route", "authority": {"registry": "flutter_screens", "id": "screen.host.event.rehearsal"}}],
          "description": "Creates a new deterministic room from the current setup while preserving the original run."
        },
        {
          "id": "export_reproduction",
          "owner": "rehearsal_controller",
          "codeValue": "exportReproduction",
          "cardinality": "unbounded",
          "scopeKeys": ["sessionId", "runtimeRevision"],
          "outcomes": [{"kind": "side_effect", "id": "clipboard.event_rehearsal_reproduction_copied"}],
          "description": "Copies the bounded seed, setup, actors, action history, and revision receipt for deterministic QA replay."
        }
      ],
      "stateIds": [
        "host_event_rehearsal_start",
        "host_event_rehearsal_loading",
        "host_event_rehearsal_error",
        "host_event_rehearsal_setup",
        "host_event_rehearsal_running",
        "host_event_rehearsal_paused",
        "host_event_rehearsal_complete",
        "host_event_rehearsal_mutation"
      ],
      "scenarioDefaults": {"dimensions": {}, "actionCases": [{"id": "no_actions"}]},
      "scenarioOverrides": {
        "host_event_rehearsal_start": {
          "actionCases": [{"id": "choose_and_create", "enabledActions": ["create_rehearsal"]}]
        },
        "host_event_rehearsal_loading": {
          "dimensions": {"projection": "loading"},
          "actionCases": [{"id": "initial_projection", "disabledActions": ["retry_rehearsal_projection"]}]
        },
        "host_event_rehearsal_error": {
          "dimensions": {"projection": "error"},
          "actionCases": [{"id": "retry", "enabledActions": ["retry_rehearsal_projection"]}]
        },
        "host_event_rehearsal_setup": {
          "actionCases": [{"id": "editable_setup", "enabledActions": ["update_rehearsal_setup", "control_virtual_event", "rotate_guest_link", "copy_guest_link", "share_guest_link", "reset_rehearsal", "fork_rehearsal", "export_reproduction"]}]
        },
        "host_event_rehearsal_running": {
          "dimensions": {"lifecycle": "running"},
          "actionCases": [{"id": "live_controls", "enabledActions": ["control_virtual_event", "simulate_rehearsal_issue", "rotate_guest_link", "copy_guest_link", "share_guest_link", "reset_rehearsal", "fork_rehearsal", "export_reproduction"]}]
        },
        "host_event_rehearsal_paused": {
          "dimensions": {"lifecycle": "paused"},
          "actionCases": [{"id": "recovery_controls", "enabledActions": ["control_virtual_event", "simulate_rehearsal_issue", "rotate_guest_link", "copy_guest_link", "share_guest_link", "reset_rehearsal", "fork_rehearsal", "export_reproduction"]}]
        },
        "host_event_rehearsal_complete": {
          "dimensions": {"lifecycle": "complete"},
          "actionCases": [{"id": "deterministic_recap", "enabledActions": ["rotate_guest_link", "copy_guest_link", "share_guest_link", "reset_rehearsal", "fork_rehearsal", "export_reproduction"]}]
        },
        "host_event_rehearsal_mutation": {
          "dimensions": {"mutation": "pending"},
          "actionCases": [{"id": "bounded_pending_action", "disabledActions": ["create_rehearsal", "update_rehearsal_setup", "control_virtual_event", "simulate_rehearsal_issue", "rotate_guest_link", "copy_guest_link", "share_guest_link", "reset_rehearsal", "fork_rehearsal", "export_reproduction"]}]
        }
      },
      "requiredEvidence": {"captures": false, "previews": false, "tests": true}
    },
    {
      "id": "guest_web",
      "runtime": "react_marketing",
      "authority": {"registry": "marketing_routes", "id": "event_rehearsal"},
      "actionScope": {
        "included": "Redeeming one deterministic anonymous browser slot, retrying an unavailable practice link, and submitting bounded guest arrival, opt-out, help, and prompt-completion actions.",
        "excluded": [
          "Authentication, OTP, production attendee claims, bookings, messages, payments, and matching are intentionally absent.",
          "Background virtual-clock polling and session-slot persistence are lifecycle effects rather than visible guest actions."
        ]
      },
      "bindings": {
        "previewSources": ["website/src/stories/EventRehearsal.stories.tsx"],
        "actionOwners": [
          {
            "id": "guest_controller",
            "language": "typescript",
            "file": "website/src/features/eventRehearsal/useEventRehearsalController.ts",
            "symbol": "useEventRehearsalController"
          }
        ],
        "componentContracts": [
          "event_rehearsal_preview",
          "route_event_rehearsal",
          "shared_event_runtime_shells",
          "shared_page_shell"
        ],
        "dataContracts": [
          "contracts/callables/get_event_rehearsal_guest_bootstrap_payload.schema.json",
          "contracts/callables/submit_event_rehearsal_guest_action_payload.schema.json",
          "contracts/callable_responses/event_rehearsal_guest_bootstrap_response.schema.json"
        ],
        "testEvidence": {
          "loading": ["website/src/features/eventRehearsal/EventRehearsalPage.test.tsx"],
          "welcome": ["website/src/features/eventRehearsal/EventRehearsalPage.test.tsx"],
          "live-moment": ["website/src/features/eventRehearsal/EventRehearsalPage.test.tsx", "website/src/features/eventRehearsal/useEventRehearsalController.test.tsx"],
          "fault": ["website/src/features/eventRehearsal/EventRehearsalPage.test.tsx"],
          "complete": ["website/src/features/eventRehearsal/EventRehearsalPage.test.tsx"],
          "unavailable": ["website/src/features/eventRehearsal/EventRehearsalPage.test.tsx"]
        }
      },
      "dimensions": {
        "projection": {"default": "ready", "values": ["loading", "ready", "unavailable"]},
        "fault": {"default": "none", "values": ["none", "active"]},
        "lifecycle": {"default": "welcome", "values": ["welcome", "live", "complete"]},
        "mutation": {"default": "idle", "values": ["idle", "pending", "failed", "success"]}
      },
      "actions": [
        {
          "id": "retry_guest_projection",
          "owner": "guest_controller",
          "codeValue": "refresh",
          "cardinality": "unbounded",
          "scopeKeys": ["publicRehearsalId", "loadGeneration"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["loading", "welcome", "live-moment", "fault", "complete", "unavailable"]}],
          "description": "Retries a guest projection after expiry, link rotation, or a simulated connection failure."
        },
        {
          "id": "submit_synthetic_guest_action",
          "owner": "guest_controller",
          "codeValue": "submit",
          "cardinality": "domain_bounded",
          "scopeKeys": ["publicRehearsalId", "slotToken", "clientActionId"],
          "outcomes": [{"kind": "surface_state", "stateIds": ["welcome", "live-moment", "fault", "complete"]}],
          "description": "Updates only the browser slot's synthetic actor and returns the next guest-safe projection."
        }
      ],
      "stateIds": ["loading", "welcome", "live-moment", "fault", "complete", "unavailable"],
      "scenarioDefaults": {"dimensions": {}, "actionCases": [{"id": "no_actions"}]},
      "scenarioOverrides": {
        "loading": {
          "dimensions": {"projection": "loading"},
          "actionCases": [{"id": "anonymous_slot_redemption"}]
        },
        "welcome": {
          "actionCases": [{"id": "arrival_actions", "enabledActions": ["submit_synthetic_guest_action"]}]
        },
        "live-moment": {
          "dimensions": {"lifecycle": "live"},
          "actionCases": [{"id": "bounded_guest_controls", "enabledActions": ["submit_synthetic_guest_action"]}]
        },
        "fault": {
          "dimensions": {"lifecycle": "live", "fault": "active"},
          "actionCases": [{"id": "visible_fault_recovery", "enabledActions": ["submit_synthetic_guest_action"]}]
        },
        "complete": {
          "dimensions": {"lifecycle": "complete"},
          "actionCases": [{"id": "read_only_completion"}]
        },
        "unavailable": {
          "dimensions": {"projection": "unavailable"},
          "actionCases": [{"id": "retry_or_expired", "enabledActions": ["retry_guest_projection"]}]
        }
      },
      "requiredEvidence": {"captures": false, "previews": true, "tests": true}
    }
  ]
}
