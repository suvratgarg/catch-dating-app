        "id": "visitor_discovery"
      },
      "actionScope": {
        "included": "Public discovery filter selection and recovery; source availability, empty results and Catch Experience eligibility remain explicit.",
        "excluded": [
          "Event/profile/Host link navigation, native disclosure controls, catalogue retry and mobile-menu focus/navigation retain their existing link, presentation and shared-chrome owners."
        ]
      },
      "bindings": {
        "previewSources": [
          "website/src/stories/MarketingRoutes.stories.tsx"
        ],
        "actionOwners": [
          {
            "id": "discovery_controller",
