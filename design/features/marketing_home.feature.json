{
  "$schema": "./feature_contract.schema.json",
  "version": 2,
  "updated": "2026-10-20",
  "id": "feature.marketing_home",
  "name": "Marketing Home",
  "owner": "marketing_website",
  "status": "pilot",
  "description": "Consumer homepage and full event discovery with public city/format filters, catalogue failure and empty states, and explicit Catch Experience participation eligibility.",
  "surfaces": [
