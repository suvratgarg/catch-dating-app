{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catch.app/design/features/host_feature_responsibilities.schema.json",
  "title": "Host top-level feature responsibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "updated",
    "owner",
    "sourceOfTruth",
    "features"
  ],
  "properties": {
    "$schema": {"const": "./host_feature_responsibilities.schema.json"},
    "version": {"const": 1},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "owner": {"const": "hosts"},
    "sourceOfTruth": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repoPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(lib|test|contracts|design)/.+"}
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "destination",
        "primaryRouteId",
        "ownedRouteIds",
        "handoffRouteIds",
        "targetRoot",
        "migrationStatus",
        "purpose",
        "responsibilities",
        "doesNotOwn",
        "currentRoots",
        "featureContractBindings",
        "additionalCodeOwners",
        "additionalDataContracts",
        "sharedDependencies",
        "testFiles"
      ],
      "properties": {
        "id": {"enum": ["today", "events", "audience", "inbox", "organizer"]},
        "destination": {"pattern": "^host[A-Z][A-Za-z0-9]+$"},
        "primaryRouteId": {"pattern": "^host[A-Z][A-Za-z0-9]+Screen$"},
        "ownedRouteIds": {"$ref": "#/$defs/nonEmptyStrings"},
        "handoffRouteIds": {"$ref": "#/$defs/nonEmptyStrings"},
        "targetRoot": {"pattern": "^lib/hosts/(today|events|audience|inbox|organizer)$"},
        "migrationStatus": {
          "enum": ["verticalSlice", "targetDefinedLegacyImplementation"]
        },
        "purpose": {"type": "string", "minLength": 1},
        "responsibilities": {"$ref": "#/$defs/nonEmptyStrings"},
        "doesNotOwn": {"$ref": "#/$defs/nonEmptyStrings"},
        "currentRoots": {"$ref": "#/$defs/repoPaths"},
        "featureContractBindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/featureContractBinding"}
        },
        "additionalCodeOwners": {
          "type": "array",
          "items": {"$ref": "#/$defs/codeOwner"}
        },
        "additionalDataContracts": {"$ref": "#/$defs/repoPaths"},
        "sharedDependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/sharedDependency"}
        },
        "testFiles": {"$ref": "#/$defs/repoPaths"}
      }
    },
    "featureContractBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "surfaceId",
        "actionOwnerIds",
        "includeDataContracts"
      ],
      "properties": {
        "contractId": {"pattern": "^feature\\.[a-z0-9_.-]+$"},
        "surfaceId": {"pattern": "^[a-z][a-z0-9_]*$"},
        "actionOwnerIds": {"$ref": "#/$defs/nonEmptyStrings"},
        "includeDataContracts": {"type": "boolean"}
      }
    },
    "codeOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "symbol", "role"],
      "properties": {
        "id": {"pattern": "^[a-z][a-z0-9_]*$"},
        "file": {"pattern": "^lib/.+\\.dart$"},
        "symbol": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "sharedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"pattern": "^(lib|contracts|design)/.+"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
