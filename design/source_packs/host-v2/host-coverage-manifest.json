{
  "$schema": "catch.host-shell-coverage/v2",
  "title": "Catch Host shell coverage",
  "updated": "2026-08-31",
  "purpose": "Advisory design and capture coverage for the five persistent Host destinations. Runtime route identity is generated by tool/ui_capture/check_route_inventory.mjs; this manifest does not replace the router, capture catalog, or screen registry.",
  "authority": {
    "routes": "tool/ui_capture/route_inventory.json",
    "captures": "tool/ui_capture/capture_coverage.json",
    "screenRegistry": "design/screens/catch.screens.json",
    "audit": "docs/design_parity/host_shell_route_ui_audit.md",
    "check": "node tool/design/check_host_shell_coverage.mjs"
  },
  "responsiveContract": {
    "compact": "<600: bottom navigation; icon-only with semantic labels at large text",
    "medium": "600-839: labelled rail; 168 px at large text",
    "expanded": ">=840: 240 px sidebar; Customers and Messaging may compose master-detail panes",
    "masterDetailIndexPaneWidth": 360
  },
  "informationArchitectureDecision": {
    "selectedOption": "forms-global-today-within-events",
    "primaryLabels": [
      "Events",
      "Customers",
      "Forms",
      "Messaging",
      "Organizer"
    ],
    "todayOwnerRouteId": "hostEventsScreen",
    "formsOwnerRouteId": "hostFormsScreen",
    "audiencesOwnerRouteId": "hostCustomersScreen",
    "inboxWorkspaceOwnerRouteId": "hostInboxScreen",
    "rationaleOwner": "docs/app_architecture.md"
  },
  "primaryRoutes": [
    {
      "destination": "hostEvents",
      "routeId": "hostEventsScreen",
      "path": "/host/events",
      "label": "Events",
      "widget": "HostOperationsHomeScreen",
      "source": "lib/hosts/presentation/host_operations/host_operations_home_screen.dart",
      "captureId": "host_home_events_list"
    },
    {
      "destination": "hostCustomers",
      "routeId": "hostCustomersScreen",
      "path": "/host/customers",
      "label": "Customers",
      "widget": "HostCustomersScreen",
      "source": "lib/hosts/presentation/customers/host_customers_screen.dart",
      "captureId": "host_customers_populated"
    },
    {
      "destination": "hostForms",
      "routeId": "hostFormsScreen",
      "path": "/host/forms",
      "label": "Forms",
      "widget": "HostFormsScreen",
      "source": "lib/hosts/presentation/forms/host_forms_screen.dart",
      "captureId": "host_forms_populated"
    },
    {
      "destination": "hostInbox",
      "routeId": "hostInboxScreen",
      "path": "/host/inbox",
      "label": "Messaging",
      "widget": "HostInboxScreen",
      "source": "lib/hosts/presentation/inbox/host_inbox_screen.dart",
      "captureId": "host_inbox_queries"
    },
    {
      "destination": "hostOrganizer",
      "routeId": "hostOrganizerScreen",
      "path": "/host/organizer",
      "label": "Organizer",
      "widget": "HostClubsScreen",
      "source": "lib/hosts/presentation/host_operations/host_clubs_screen.dart",
      "captureId": "host_clubs_management"
    }
  ],
  "legacyRoutes": [
    {
      "routeId": "hostHomeScreen",
      "path": "/host",
      "status": "redirect",
      "canonicalRouteId": "hostEventsScreen"
    }
  ],
  "notes": [
    "Utility and nested Host routes remain covered by the generated route inventory and capture coverage rather than being duplicated here.",
    "A green shell contract proves ordered destination, route, source, and canonical capture ownership. It does not claim visual parity for uncaptured states."
  ]
}
