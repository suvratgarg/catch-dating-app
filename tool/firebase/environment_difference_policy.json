{
  "version": 1,
  "principle": "dev, staging and prod differ only in identity: project ids, credentials, endpoints, provider account ids and local test tooling. Which features exist must be identical. A feature gate may differ between environments only through one unexpired allowedDifferences entry naming its owner, expiry and Linear ticket.",
  "classes": {
    "identity": "Environment identity, credentials, provider account ids, endpoints, secret version references and local test tooling. Values may differ and are fingerprinted, never printed.",
    "feature-gate": "Decides whether a feature or behavior exists. Must be identical in every environment unless an allowedDifferences entry applies.",
    "release-state": "Per-environment release bookkeeping such as force-update floors and store listing URLs. Values may differ and are printed."
  },
