{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catch.app/tool/harness/component_graph.schema.json",
  "title": "Catch Harness v2 component graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "modes",
    "targets",
    "deployGroupRequirements",
    "ciCheckout",
    "operationProfiles",
    "classifications",
    "components",
    "compileCodegen"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "required"},
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["pr", "merge_group", "main", "nightly", "release"]}
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "deployGroupRequirements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "ciCheckout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "default", "targetOverrides"],
      "properties": {
        "planner": {"$ref": "#/$defs/checkoutRequirement"},
        "default": {"$ref": "#/$defs/checkoutRequirement"},
        "targetOverrides": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/checkoutRequirement"}
        }
      }
    },
    "operationProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/operationProfile"}
    },
    "classifications": {
      "type": "array",
      "items": {"$ref": "#/$defs/classification"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "compileCodegen": {
      "type": "array",
      "items": {"$ref": "#/$defs/codegen"}
    }
  },
  "$defs": {
    "checkoutRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fetchDepth", "timeoutMinutes"],
      "properties": {
        "mode": {"enum": ["full", "sparse"]},
        "fetchDepth": {"type": "integer", "minimum": 0, "maximum": 1000},
        "coneMode": {"type": "boolean"},
        "timeoutMinutes": {"type": "integer", "minimum": 1, "maximum": 10},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "sparse"}}},
          "then": {"required": ["coneMode", "paths"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["coneMode"]},
                {"required": ["paths"]}
              ]
            }
          }
        }
      ]
    },
    "pathSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "components", "terminal"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "paths": {"$ref": "#/$defs/pathSet"},
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "terminal": {"const": true}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "risk",
        "operationProfile",
        "dependsOn",
        "alsoAffects",
        "pathType"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "risk": {"enum": ["low", "standard", "high"]},
        "operationProfile": {"type": "string", "minLength": 1},
        "pathType": {"enum": ["terminal", "component", "consumer"]},
        "ownedPaths": {"$ref": "#/$defs/pathSet"},
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "alsoAffects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "description": {"type": "string", "minLength": 1}
      }
    },
    "operationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "affected"],
      "properties": {
        "direct": {"$ref": "#/$defs/modeOperations"},
        "affected": {"$ref": "#/$defs/modeOperations"}
      }
    },
    "modeOperations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/operation"}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ciTargets": {"$ref": "#/$defs/stringSet"},
        "checkIds": {"$ref": "#/$defs/stringSet"},
        "codegenIds": {"$ref": "#/$defs/stringSet"},
        "buildTargets": {"$ref": "#/$defs/stringSet"},
        "releaseTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "consumer-android",
              "consumer-ios",
              "host-android",
              "host-ios"
            ]
          }
        },
        "deployGroups": {"$ref": "#/$defs/stringSet"},
        "releaseRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["consumer", "host"]}
        }
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "codegen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "inputs",
        "outputs",
        "checkCommand",
        "writeCommand",
        "platforms",
        "deterministic",
        "network",
        "timeoutSeconds"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "checkCommand": {"type": "string", "minLength": 1},
        "writeCommand": {"type": "string", "minLength": 1},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["darwin", "linux", "win32"]}
        },
        "deterministic": {"const": true},
        "network": {"const": false},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    }
  }
}
