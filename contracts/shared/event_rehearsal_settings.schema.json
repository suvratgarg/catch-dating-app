{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/event_rehearsal_settings.schema.json",
  "title": "EventRehearsalSettings",
  "description": "Isolated event-wide practice rules and explicit simulated channel/outcome configuration. Saved setup revisions fence this state; no live sender, permission or provider authority is copied.",
  "definitions": {
    "Template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "setting",
        "config"
      ],
      "properties": {
        "kind": {
          "const": "lateJoin"
        },
        "version": {
          "const": 1
        },
        "setting": {
          "$ref": "event_assistance_settings.schema.json#/definitions/TemplateSetting"
        },
        "config": {
          "$ref": "event_assistance_settings.schema.json#/definitions/LateJoinTemplateConfig"
        }
      }
    },
    "Preference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "inherit"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "disabled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "template"
          ],
          "properties": {
            "kind": {
              "const": "configured"
            },
            "template": {
              "$ref": "#/definitions/Template"
            }
          }
        }
      ]
    },
    "Configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routes",
        "deliveryPolicy",
        "responseDeadline",
        "outcomes"
      ],
      "properties": {
        "routes": {
          "$ref": "event_rehearsal_assistance.schema.json#/definitions/plan/properties/routes"
        },
        "deliveryPolicy": {
          "$ref": "event_rehearsal_assistance.schema.json#/definitions/plan/properties/deliveryPolicy"
        },
        "responseDeadline": {
          "$ref": "event_rehearsal_assistance.schema.json#/definitions/plan/properties/responseDeadline"
        },
        "laterChoices": {
          "$ref": "event_rehearsal_assistance.schema.json#/definitions/plan/properties/laterChoices"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "event_rehearsal_assistance.schema.json#/definitions/outcome"
          }
        }
      }
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "configuration"
      ],
      "properties": {
        "status": {
          "enum": [
            "enabled",
            "paused"
          ]
        },
        "configuration": {
          "$ref": "#/definitions/Configuration"
        }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clockId",
        "runtime",
        "preferences"
      ],
      "properties": {
        "clockId": {
          "type": "string",
          "pattern": "^clock:[a-f0-9]{64}$"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/definitions/Runtime"
            },
            {
              "type": "null"
            }
          ]
        },
        "preferences": {
          "type": "array",
          "maxItems": 41,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groupId",
              "preference"
            ],
            "properties": {
              "groupId": {
                "$ref": "event_common.schema.json#/definitions/documentId"
              },
              "preference": {
                "$ref": "#/definitions/Preference"
              }
            }
          }
        }
      }
    },
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expectedSourceHash",
            "groupId",
            "preference"
          ],
          "properties": {
            "kind": {
              "const": "setRule"
            },
            "expectedSourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "groupId": {
              "$ref": "event_common.schema.json#/definitions/documentId"
            },
            "preference": {
              "$ref": "#/definitions/Preference"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expectedSourceHash",
            "configuration"
          ],
          "properties": {
            "kind": {
              "const": "configure"
            },
            "expectedSourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "configuration": {
              "$ref": "#/definitions/Configuration"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expectedSourceHash"
          ],
          "properties": {
            "kind": {
              "const": "pause"
            },
            "expectedSourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ],
      "type": "object"
    },
    "Group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "label",
        "preference",
        "effective",
        "status",
        "origin",
        "setup"
      ],
      "properties": {
        "groupId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "preference": {
          "$ref": "#/definitions/Preference"
        },
        "effective": {
          "anyOf": [
            {
              "$ref": "#/definitions/Template"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "unconfigured",
            "disabled",
            "sourceChanged",
            "configured"
          ]
        },
        "origin": {
          "enum": [
            "none",
            "event",
            "group"
          ]
        },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventEnd",
            "destinations"
          ],
          "properties": {
            "eventEnd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "destinations": {
              "type": "array",
              "maxItems": 41,
              "items": {
                "$ref": "event_rehearsal_movement.schema.json#/definitions/Destination"
              }
            }
          }
        }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "setupRevision",
        "runtimeRevision",
        "sourceHash",
        "serverTime",
        "canConfigure",
        "runtime",
        "suggested",
        "groups"
      ],
      "properties": {
        "context": {
          "allOf": [
            {
              "$ref": "event_assistance_common.schema.json#/definitions/ExecutionContext"
            },
            {
              "properties": {
                "mode": {
                  "const": "rehearsal"
                }
              }
            }
          ]
        },
        "setupRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runtimeRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "serverTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canConfigure": {
          "type": "boolean"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/definitions/Runtime"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested": {
          "$ref": "#/definitions/Template"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 41,
          "items": {
            "$ref": "#/definitions/Group"
          }
        }
      }
    }
  }
}
