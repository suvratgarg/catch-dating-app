{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/event_rehearsal_movement.schema.json",
  "title": "EventRehearsalMovement",
  "definitions": {
    "Member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attendeeId",
        "displayName",
        "visitHash",
        "episodeId",
        "membershipHash"
      ],
      "properties": {
        "attendeeId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "visitHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "episodeId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^episode:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "membershipHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "label",
        "text"
      ],
      "properties": {
        "target": {
          "$ref": "event_assistance_common.schema.json#/definitions/JoiningTarget"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "Departure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHash",
        "destination",
        "confirmedAt",
        "confirmedBy",
        "operationId",
        "roster",
        "checkpointRequest"
      ],
      "properties": {
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "destination": {
          "$ref": "event_assistance_common.schema.json#/definitions/JoiningTarget"
        },
        "confirmedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "confirmedBy": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "operationId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "roster": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "members",
                "selectionHash"
              ],
              "properties": {
                "members": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "$ref": "#/definitions/Member"
                  }
                },
                "selectionHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpointRequest": {
          "anyOf": [
            {
              "$ref": "event_assistance_departure_roster.schema.json#/definitions/CheckpointRequest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "rosterHash",
        "accountedFor",
        "reportedAt",
        "reportedBy",
        "correctionReason"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rosterHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "accountedFor": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          }
        },
        "reportedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reportedBy": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "correctionReason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "clockId",
        "groupId",
        "progressRevision",
        "departure",
        "report"
      ],
      "properties": {
        "sessionId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "clockId": {
          "type": "string",
          "pattern": "^clock:[a-f0-9]{64}$"
        },
        "groupId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "progressRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "departure": {
          "$ref": "#/definitions/Departure"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/definitions/Report"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignment": {
          "$ref": "#/definitions/Reassignment"
        },
        "closeout": {
          "$ref": "#/definitions/CloseoutChange"
        }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId"
      ],
      "properties": {
        "groupId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "progressRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "beforeRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 501
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "sourceHash",
        "eventOpen",
        "runtimeLive",
        "destinations",
        "current",
        "guidance"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "eventOpen": {
          "type": "boolean"
        },
        "runtimeLive": {
          "type": "boolean"
        },
        "destinations": {
          "type": "array",
          "maxItems": 41,
          "items": {
            "$ref": "#/definitions/Destination"
          }
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/definitions/Record"
            },
            {
              "type": "null"
            }
          ]
        },
        "guidance": {
          "anyOf": [
            {
              "$ref": "event_assistance_common.schema.json#/definitions/JoiningGuidance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Roster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHash",
        "members",
        "unavailable",
        "coverage"
      ],
      "properties": {
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "members": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/Member"
          }
        },
        "unavailable": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attendeeId",
              "reason"
            ],
            "properties": {
              "attendeeId": {
                "$ref": "event_common.schema.json#/definitions/documentId"
              },
              "reason": {
                "enum": [
                  "notCheckedIn",
                  "participationUnavailable",
                  "membershipUnavailable",
                  "invalidSource"
                ]
              }
            }
          }
        },
        "coverage": {
          "const": "boundedSession"
        }
      }
    },
    "Checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progressRevision",
        "checkpointId",
        "sourceHash",
        "revision",
        "availability",
        "report",
        "request",
        "departure"
      ],
      "properties": {
        "progressRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "checkpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "availability": {
          "$ref": "event_assistance_checkpoint.schema.json#/definitions/View/properties/availability"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/definitions/Report"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "event_assistance_checkpoint.schema.json#/definitions/RequestView"
            },
            {
              "type": "null"
            }
          ]
        },
        "departure": {
          "$ref": "#/definitions/Departure"
        },
        "assignment": {
          "anyOf": [
            {
              "$ref": "#/definitions/AssignmentView"
            },
            {
              "type": "null"
            }
          ]
        },
        "closeout": {
          "anyOf": [
            {
              "$ref": "#/definitions/CloseoutView"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progressRevision",
        "destination",
        "confirmedAt",
        "rosterSize",
        "reportRevision",
        "accountedForCount",
        "checkpointRequest"
      ],
      "properties": {
        "progressRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "destination": {
          "$ref": "event_assistance_common.schema.json#/definitions/JoiningTarget"
        },
        "confirmedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rosterSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            {
              "type": "null"
            }
          ]
        },
        "reportRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accountedForCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "checkpointRequest": {
          "anyOf": [
            {
              "$ref": "event_assistance_departure_roster.schema.json#/definitions/CheckpointRequest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "organizerId",
        "clockId",
        "setupRevision",
        "runtimeRevision",
        "actorUid",
        "serverTime",
        "groupId",
        "groups",
        "progress",
        "roster",
        "selected",
        "checkpoint",
        "history",
        "nextBeforeRevision"
      ],
      "properties": {
        "sessionId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "organizerId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "clockId": {
          "type": "string",
          "pattern": "^clock:[a-f0-9]{64}$"
        },
        "setupRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "runtimeRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "actorUid": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "serverTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "groupId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "groups": {
          "type": "array",
          "maxItems": 41,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groupId",
              "label"
            ],
            "properties": {
              "groupId": {
                "$ref": "event_common.schema.json#/definitions/documentId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "progress": {
          "$ref": "#/definitions/Progress"
        },
        "roster": {
          "$ref": "#/definitions/Roster"
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/definitions/Checkpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/definitions/Summary"
          }
        },
        "nextBeforeRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 501
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/definitions/Record"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload",
            "expectedSourceHash"
          ],
          "properties": {
            "kind": {
              "const": "confirmDeparture"
            },
            "payload": {
              "$ref": "event_assistance_common.schema.json#/definitions/ConfirmDepartureCommand/properties/payload"
            },
            "expectedSourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload",
            "expectedSourceHash"
          ],
          "properties": {
            "kind": {
              "const": "recordCheckpoint"
            },
            "payload": {
              "$ref": "event_assistance_common.schema.json#/definitions/RecordCheckpointCommand/properties/payload"
            },
            "expectedSourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload",
            "expectedSourceHash"
          ],
          "properties": {
            "kind": {
              "const": "reassignCheckpointReporter"
            },
            "payload": {
              "$ref": "event_assistance_common.schema.json#/definitions/ReassignCheckpointReporterCommand/properties/payload"
            },
            "expectedSourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload",
            "expectedSourceHash"
          ],
          "properties": {
            "kind": {
              "const": "setCheckpointCloseout"
            },
            "payload": {
              "$ref": "event_assistance_common.schema.json#/definitions/SetCheckpointCloseoutCommand/properties/payload"
            },
            "expectedSourceHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ],
      "type": "object"
    },
    "Reassignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "operationId",
        "responsibleOperatorId",
        "previousResponsibleOperatorId",
        "assignedBy",
        "assignedAt",
        "reason"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "responsibleOperatorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/]+$"
        },
        "previousResponsibleOperatorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/]+$"
        },
        "assignedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/]+$"
        },
        "assignedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "operationId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        }
      }
    },
    "AssignmentView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "sourceHash",
        "change"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/definitions/Reassignment"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CloseoutChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "previousRevision",
        "operationId",
        "changedBy",
        "changedAt",
        "reason",
        "decision"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previousRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/]+$"
        },
        "changedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "decision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "report",
                "dispositions"
              ],
              "properties": {
                "kind": {
                  "const": "close"
                },
                "report": {
                  "$ref": "#/definitions/Report"
                },
                "dispositions": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "$ref": "event_assistance_checkpoint.schema.json#/definitions/CloseoutDisposition"
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "reopen"
                }
              }
            }
          ]
        },
        "operationId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        }
      }
    },
    "CloseoutView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "sourceHash",
        "change",
        "state",
        "eligibility"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/definitions/CloseoutChange"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "event_assistance_checkpoint.schema.json#/definitions/CloseoutView/properties/state"
        },
        "eligibility": {
          "$ref": "event_assistance_checkpoint.schema.json#/definitions/CloseoutView/properties/eligibility"
        }
      }
    }
  }
}
