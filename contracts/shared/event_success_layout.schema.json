{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/event_success_layout.schema.json",
  "title": "Event Success spatial layout definitions",
  "definitions": {
    "layoutShape": {
      "type": "string",
      "enum": ["round", "rect", "row", "court", "zone"]
    },
    "layoutUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "shape", "capacity", "gridX", "gridY", "order"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "shape": {"$ref": "#/definitions/layoutShape"},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 1000},
        "gridX": {"type": "integer", "minimum": 0, "maximum": 199},
        "gridY": {"type": "integer", "minimum": 0, "maximum": 199},
        "order": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "label", "units"],
      "properties": {
        "layoutId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/definitions/layoutUnit"}
        }
      }
    },
    "affinityConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aUid", "bUid", "value", "scope"],
      "properties": {
        "aUid": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "bUid": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "value": {"type": "string", "enum": ["mustPair", "mustSplit", "avoidRepeat", "neutral"]},
        "scope": {"type": "string", "enum": ["thisRound", "pinned"]}
      }
    },
    "spatialOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "targetPeerUid", "layoutUnitId", "scope"],
      "properties": {
        "uid": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "targetPeerUid": {"$ref": "event_common.schema.json#/definitions/documentId"},
        "layoutUnitId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
        "scope": {"type": "string", "enum": ["thisRound", "pinned"]}
      }
    }
  }
}
