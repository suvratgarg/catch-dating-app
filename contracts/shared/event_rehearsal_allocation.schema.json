{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/event_rehearsal_allocation.schema.json",
  "title": "Event rehearsal allocation definitions",
  "description": "Revision-fenced synthetic allocation proposals and publications for dress rehearsal only.",
  "definitions": {
    "ProposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "DecisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "UnitId": {
      "type": "string",
      "pattern": "^table-[1-9][0-9]*$",
      "maxLength": 40
    },
    "Proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId",
        "attendeeIds",
        "targetUnitId",
        "baseRevision",
        "status",
        "decisionId",
        "publishedRevision",
        "proposedBy",
        "operationId",
        "proposedAt",
        "publishedAt"
      ],
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "attendeeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          }
        },
        "targetUnitId": {
          "$ref": "#/definitions/UnitId"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "published",
            "stale"
          ]
        },
        "decisionId": {
          "oneOf": [
            {
              "$ref": "#/definitions/DecisionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "proposedBy": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "operationId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "proposedAt": {
          "$ref": "event_common.schema.json#/definitions/timestamp"
        },
        "publishedAt": {
          "$ref": "event_common.schema.json#/definitions/nullableTimestamp"
        }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "proposals"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "proposals": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Proposal"
          }
        }
      }
    },
    "AssignmentView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attendeeId",
        "unitId"
      ],
      "properties": {
        "attendeeId": {
          "$ref": "event_common.schema.json#/definitions/documentId"
        },
        "unitId": {
          "oneOf": [
            {
              "$ref": "#/definitions/UnitId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProposalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId",
        "attendeeIds",
        "targetUnitId",
        "baseRevision",
        "status",
        "decisionId",
        "publishedRevision",
        "proposedAt",
        "publishedAt"
      ],
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "attendeeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          }
        },
        "targetUnitId": {
          "$ref": "#/definitions/UnitId"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "published",
            "stale"
          ]
        },
        "decisionId": {
          "oneOf": [
            {
              "$ref": "#/definitions/DecisionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedRevision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "proposedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "publishedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "unitIds",
        "assignments",
        "proposals"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "unitIds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/UnitId"
          }
        },
        "assignments": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/AssignmentView"
          }
        },
        "proposals": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/ProposalView"
          }
        }
      }
    },
    "ProposeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attendeeIds",
        "targetUnitId",
        "expectedAllocationRevision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "propose"
        },
        "attendeeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          }
        },
        "targetUnitId": {
          "$ref": "#/definitions/UnitId"
        },
        "expectedAllocationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "PublishCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "proposalId",
        "decisionId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "publish"
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "decisionId": {
          "$ref": "#/definitions/DecisionId"
        }
      }
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "propose",
            "publish"
          ]
        },
        "attendeeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "event_common.schema.json#/definitions/documentId"
          }
        },
        "targetUnitId": {
          "$ref": "#/definitions/UnitId"
        },
        "expectedAllocationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "decisionId": {
          "$ref": "#/definitions/DecisionId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "propose"
              }
            }
          },
          "then": {
            "required": [
              "attendeeIds",
              "targetUnitId",
              "expectedAllocationRevision"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "proposalId"
                  ]
                },
                {
                  "required": [
                    "decisionId"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "proposalId",
              "decisionId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "attendeeIds"
                  ]
                },
                {
                  "required": [
                    "targetUnitId"
                  ]
                },
                {
                  "required": [
                    "expectedAllocationRevision"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
