{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/participant_activity_common.schema.json",
  "title": "Participant activity common contract definitions",
  "description": "Owned immutable submission metadata; a form event target is not admission proof.",
  "definitions": {
    "formResponseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceId",
        "organizerId",
        "eventId",
        "formId",
        "versionId",
        "formTitle",
        "purpose",
        "submittedAtMillis"
      ],
      "properties": {
        "sourceKind": {
          "type": "string",
          "const": "formResponse"
        },
        "sourceId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "organizerId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "formId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "versionId": {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        "eventId": {
          "anyOf": [
            {
              "$ref": "../shared/event_common.schema.json#/definitions/documentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "formTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "purpose": {
          "$ref": "organizer_form_common.schema.json#/definitions/formPurpose"
        },
        "submittedAtMillis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
