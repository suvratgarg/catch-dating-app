              "const": "joinIntent",
              "type": "string"
            },
            "intention": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "claimedEta"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "onMyWay"
                    },
                    "claimedEta": {
                      "anyOf": [
                        {
                          "type": "integer",
