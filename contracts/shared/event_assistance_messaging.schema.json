                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "notComing"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "instructionRevision"
