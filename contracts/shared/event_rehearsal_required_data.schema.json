{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/event_rehearsal_required_data.schema.json",
  "title": "Event rehearsal required-data definitions",
  "description": "Synthetic-only profile completion state for rehearsing a required-data request without collecting or copying real attendee data.",
  "definitions": {
    "RequestState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "sourceHash",
        "fieldIds",
        "completedFieldIds",
        "status",
        "requestedAt",
        "expiresAt",
        "completedAt"
      ],
      "properties": {
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/NonEmptyRuntimeFieldIds"
        },
        "completedFieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/RuntimeFieldIds"
        },
        "status": {"type": "string", "enum": ["pending", "completed"]},
        "requestedAt": {"$ref": "event_common.schema.json#/definitions/timestamp"},
        "expiresAt": {"$ref": "event_common.schema.json#/definitions/timestamp"},
        "completedAt": {"$ref": "event_common.schema.json#/definitions/nullableTimestamp"}
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileRevision",
        "completedFieldIds",
        "requestRevision",
        "request"
      ],
      "properties": {
        "profileRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "completedFieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/RuntimeFieldIds"
        },
        "requestRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "request": {
          "anyOf": [
            {"$ref": "#/definitions/RequestState"},
            {"type": "null"}
          ]
        }
      }
    },
    "RequestView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "fieldIds",
        "completedFieldIds",
        "status",
        "requestedAt",
        "expiresAt",
        "completedAt"
      ],
      "properties": {
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "fieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/NonEmptyRuntimeFieldIds"
        },
        "completedFieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/RuntimeFieldIds"
        },
        "status": {"type": "string", "enum": ["pending", "completed", "expired"]},
        "requestedAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "expiresAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "completedAt": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHash",
        "profileRevision",
        "requestRevision",
        "availableFieldIds",
        "completedFieldIds",
        "request"
      ],
      "properties": {
        "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profileRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "requestRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "availableFieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/RuntimeFieldIds"
        },
        "completedFieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/RuntimeFieldIds"
        },
        "request": {
          "anyOf": [
            {"$ref": "#/definitions/RequestView"},
            {"type": "null"}
          ]
        }
      }
    },
    "HostCommand": {
      "$ref": "event_assistance_common.schema.json#/definitions/RequestRequiredDataCommand/properties/payload"
    },
    "GuestSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldIds",
        "expectedProfileRevision",
        "expectedRequestRevision",
        "expectedSourceHash"
      ],
      "properties": {
        "fieldIds": {
          "$ref": "event_runtime_profile.schema.json#/definitions/NonEmptyRuntimeFieldIds"
        },
        "expectedProfileRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "expectedRequestRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expectedSourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
