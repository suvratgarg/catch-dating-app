{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/shared/event_runtime_profile.schema.json",
  "title": "Event runtime profile definitions",
  "definitions": {
    "RuntimeFieldId": {
      "type": "string",
      "enum": [
        "displayName",
        "gender",
        "interestedInGenders",
        "relationshipGoal",
        "dateOfBirth",
        "paceBand",
        "skillBand",
        "dietaryAndSeatingNotes",
        "questionnaireAnswerIds",
        "teamName"
      ]
    },
    "RuntimeFieldIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": {"$ref": "#/definitions/RuntimeFieldId"}
    },
    "NonEmptyRuntimeFieldIds": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/definitions/RuntimeFieldId"}
    }
  }
}
