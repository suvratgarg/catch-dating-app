{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/http/host_acquisition_consent_request.schema.json",
  "title": "HostAcquisitionConsentHTTPRequest",
  "description": "Anonymous device-specific grant or withdrawal. Capability is 32 random bytes and must never be logged. Old intake analytics is not this permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "capability"
  ],
  "properties": {
    "action": {
      "enum": [
        "grant",
        "revoke"
      ]
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "$ref": "#/definitions/choice"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "grant"
          }
        }
      },
      "then": {
        "required": [
          "choice"
        ]
      },
      "else": {
        "properties": {
          "choice": false
        }
      }
    }
  ],
  "definitions": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "analytics",
        "advertising",
        "chosenAt"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "host_acquisition_measurement"
        },
        "analytics": {
          "const": true
        },
        "advertising": {
          "type": "boolean"
        },
        "chosenAt": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
