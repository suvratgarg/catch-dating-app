{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/embedded/external_event_blocker_resolution.schema.json",
  "title": "ExternalEventBlockerResolution",
  "description": "One explicit, event-scoped resolution or policy-backed waiver for a governed external-event import blocker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["blockerCode", "outcome", "policyGapDecisionId", "note"],
  "properties": {
    "blockerCode": {
      "type": "string",
      "enum": [
        "missing_exact_coordinates",
        "missing_end_time",
        "missing_location_detail",
        "requires_event_defaults_policy",
        "requires_owner_safe_copy_review",
        "duplicate_normalized_event_key"
      ]
    },
    "outcome": {"type": "string", "enum": ["resolved", "waived"]},
    "policyGapDecisionId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 180
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "waived"}}},
      "then": {"properties": {"policyGapDecisionId": {"type": "string"}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "resolved"}}},
      "then": {"properties": {"policyGapDecisionId": {"type": "null"}}}
    }
  ]
}
