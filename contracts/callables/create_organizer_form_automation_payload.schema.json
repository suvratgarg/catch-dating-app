{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/create_organizer_form_automation_payload.schema.json",
  "title": "CreateOrganizerFormAutomationCallablePayload",
  "description": "Creates or replaces an explicit form automation under an optimistic revision guard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "formId", "ruleId", "requestId", "expectedRevision", "name", "enabled", "trigger", "condition", "actions"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "formId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "ruleId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}]},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "expectedRevision": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "enabled": {"type": "boolean"},
    "trigger": {"$ref": "../shared/organizer_form_operations_common.schema.json#/definitions/automationTrigger"},
    "condition": {"anyOf": [{"$ref": "../shared/organizer_form_common.schema.json#/definitions/logicCondition"}, {"type": "null"}]},
    "actions": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "../shared/organizer_form_operations_common.schema.json#/definitions/automationAction"}}
  }
}
