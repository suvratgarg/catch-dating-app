  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "featureId", "responseId", "decision", "expectedRevision", "requestId"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "featureId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "responseId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "decision": {"enum": ["grant", "withdraw"]},
    "expectedRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "requestId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"}
  }
}
