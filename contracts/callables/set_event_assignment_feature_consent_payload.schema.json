{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/set_event_assignment_feature_consent_payload.schema.json",
  "title": "SetEventAssignmentFeatureConsentCallablePayload",
