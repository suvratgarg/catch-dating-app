{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/admin_sales_outreach_list_response.schema.json",
  "title": "AdminListSalesOutreachDraftsResponse",
  "type": "object", "additionalProperties": false,
  "required": ["rows"],
  "properties": {"rows": {"type": "array", "maxItems": 50, "items": {
