    "properties": {
      "draftId": {"$ref": "#/definitions/id"},
      "contactId": {"$ref": "#/definitions/id"},
      "opportunityId": {"$ref": "#/definitions/id"},
      "subject": {"type": ["string", "null"], "maxLength": 300},
      "status": {"enum": ["pending_review", "approved"]},
      "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "createdAt": {"type": "string", "format": "date-time"},
      "reviewedAt": {"type": ["string", "null"], "format": "date-time"}
    }
  }}},
  "definitions": {"id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}}
}
