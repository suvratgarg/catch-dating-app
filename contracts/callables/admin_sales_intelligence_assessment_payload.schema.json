{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/admin_sales_intelligence_assessment_payload.schema.json",
  "title": "AdminSaveSalesFactorAssessmentPayload",
  "type": "object", "additionalProperties": false,
  "required": ["requestId", "organizerId", "factorId", "expectedRevision", "state", "value", "evidenceIds", "reason"],
  "properties": {
    "requestId": {"$ref": "#/definitions/id"},
    "organizerId": {"$ref": "#/definitions/id"},
    "factorId": {"$ref": "#/definitions/id"},
    "expectedRevision": {"type": "integer", "minimum": 0},
    "state": {"enum": ["known", "unknown", "disputed"]},
    "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "evidenceIds": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "reason": {"type": ["string", "null"], "maxLength": 240}
  },
  "definitions": {"id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}}
}
