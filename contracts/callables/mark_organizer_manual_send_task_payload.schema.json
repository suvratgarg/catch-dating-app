  "required": ["organizerId", "taskId", "expectedRevision", "action"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "taskId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "expectedRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "action": {"type": "string", "enum": ["hostMarkedSent", "skipped", "cancelled"]}
  }
}
