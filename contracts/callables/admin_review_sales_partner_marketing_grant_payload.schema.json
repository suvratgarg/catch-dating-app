{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/admin_review_sales_partner_marketing_grant_payload.schema.json",
  "title": "AdminReviewSalesPartnerMarketingGrantCallablePayload",
  "x-callable-aliases": [
    "adminReviewSalesPartnerMarketingGrant"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partnerUid",
    "organizerId",
    "campaignId",
    "channel",
    "assetIds",
    "requestId",
    "expectedMembershipRevision",
    "expectedGrantRevision",
    "sourceHash",
    "expiresAt",
    "reason"
  ],
  "properties": {
    "partnerUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "organizerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "campaignId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "other"
      ]
    },
    "assetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expectedMembershipRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "expectedGrantRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 48
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
