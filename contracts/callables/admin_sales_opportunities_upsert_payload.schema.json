{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/admin_sales_opportunities_upsert_payload.schema.json",
  "title": "Sales opportunities.upsert callable payload",
  "description": "Private bounded Sales callable request. Server authorization and transaction policy are enforced separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizerId",
    "requestId",
    "expectedRevision",
    "fields"
  ],
  "properties": {
    "organizerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "opportunityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion",
        "stage",
        "ownerUid",
        "nextStep",
        "nextStepAt"
      ],
      "properties": {
        "motion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "stage": {
          "enum": [
            "new_enquiry",
            "ready_to_contact",
            "contacted",
            "in_conversation",
            "demo_arranged",
            "demo_completed",
            "pilot_agreed",
            "pilot_running",
            "commercial_discussion",
            "closed_won",
            "closed_lost"
          ]
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "nextStep": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 320
        },
        "nextStepAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
