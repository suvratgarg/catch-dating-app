{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/create_organizer_form_payload.schema.json",
  "title": "CreateOrganizerFormCallablePayload",
  "description": "Creates one organizer-owned generic form draft from a versioned template.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "templateId", "requestId", "title", "defaultTargetKind", "defaultTargetId"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "templateId": {"type": "string", "minLength": 1, "maxLength": 120},
    "requestId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "title": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "defaultTargetKind": {"$ref": "../shared/organizer_form_common.schema.json#/definitions/targetKind"},
    "defaultTargetId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}]}
  }
}
