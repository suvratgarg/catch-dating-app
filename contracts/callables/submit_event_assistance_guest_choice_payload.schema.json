{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/submit_event_assistance_guest_choice_payload.schema.json",
  "title": "SubmitEventAssistanceGuestChoiceCallablePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "linkId",
    "secret",
    "intentId",
    "intentRevision",
    "expectedGuestRevision",
    "choiceId",
    "requestId"
  ],
  "properties": {
    "linkId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "intentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "intentRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedGuestRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "choiceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
