{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/set_event_chat_reaction_payload.schema.json",
  "title": "SetEventChatReactionCallablePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "messageId",
    "requestId",
    "reaction",
    "expectedRevision"
  ],
  "properties": {
    "eventId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "messageId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "requestId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "reaction": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "like",
            "love",
            "laugh",
            "wow",
            "sad",
            "thanks"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
