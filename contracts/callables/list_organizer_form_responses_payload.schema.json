    "statuses": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "../shared/organizer_form_response_common.schema.json#/definitions/responseStatus"}},
    "identityKinds": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "../shared/organizer_form_response_common.schema.json#/definitions/responseIdentityKind"}},
