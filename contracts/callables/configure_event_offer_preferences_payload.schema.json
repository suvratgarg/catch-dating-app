{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/configure_event_offer_preferences_payload.schema.json",
  "title": "ConfigureEventOfferPreferencesCallablePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizerId",
    "eventId",
    "requestId",
    "expectedEventSourceRevision",
    "expectedPreferencesRevision",
    "reviewedDefaultsHash",
    "intents"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "eventId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "expectedPreferencesRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "reviewedDefaultsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intents": {
      "$ref": "../embedded/event_preference_intents.schema.json"
    },
    "expectedEventSourceRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
