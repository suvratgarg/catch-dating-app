{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/manage_event_chat_member_payload.schema.json",
  "title": "ManageEventChatMemberCallablePayload",
  "description": "Organizer manager removes, bans or explicitly reinstates a room member. Reinstatement never joins on the participant's behalf.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "targetUid", "action", "expectedRevision", "requestId", "expectedUid"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "targetUid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "action": {"enum": ["remove", "ban", "reinstate"]},
    "expectedRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "requestId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "expectedUid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"}
  }
}
