{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/submit_event_rehearsal_guest_action_payload.schema.json",
  "title": "SubmitEventRehearsalGuestActionCallablePayload",
  "description": "Applies a bounded action from an anonymous rehearsal guest slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publicRehearsalId",
    "slotToken",
    "clientActionId",
    "action"
  ],
  "properties": {
    "publicRehearsalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{20,80}$"
    },
    "slotToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{20,180}$"
    },
    "clientActionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,120}$"
    },
    "action": {
      "$ref": "../shared/event_rehearsal_common.schema.json#/definitions/guestAction"
    },
    "messageId": {
      "type": "string",
      "pattern": "^outbox:[a-f0-9]{64}$"
    },
    "intentRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "choiceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "if": {
    "properties": {
      "action": {
        "const": "respondToAssistance"
      }
    }
  },
  "then": {
    "required": [
      "messageId",
      "intentRevision",
      "choiceId"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "messageId"
          ]
        },
        {
          "required": [
            "intentRevision"
          ]
        },
        {
          "required": [
            "choiceId"
          ]
        }
      ]
    }
  }
}
