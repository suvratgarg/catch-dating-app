{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/prepare_organizer_manual_send_task_payload.schema.json",
  "title": "PrepareOrganizerManualSendTaskCallablePayload",
  "description": "Persists one queued individual external handoff before the client attempts to open the external application.",
  "x-callable-aliases": ["prepareOrganizerManualSendTask"],
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "contactId", "requestId", "intent", "prefillText"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "contactId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 120, "pattern": "^[A-Za-z0-9._:-]+$"},
    "intent": {"const": "individualConversation"},
    "prefillText": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
