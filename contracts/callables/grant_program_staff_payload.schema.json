{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/grant_program_staff_payload.schema.json",
  "title": "GrantProgramStaffCallablePayload",
  "description": "Grant named, station-scoped program duties to a signed-in account. Manager-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "phoneNumber",
    "duties",
    "expiresAtMillis"
  ],
  "properties": {
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "phoneNumber": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32
    },
    "duties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "../shared/program_common.schema.json#/definitions/programStaffDutyAssignment"
      }
    },
    "expiresAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
