{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/create_organizer_form_share_link_payload.schema.json",
  "title": "CreateOrganizerFormShareLinkCallablePayload",
  "description": "Creates an idempotent source-attributed link for a published form.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "formId", "label", "source", "requestId"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "formId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "label": {"type": "string", "minLength": 1, "maxLength": 120},
    "source": {"type": ["string", "null"], "maxLength": 120},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,120}$"}
  }
}
