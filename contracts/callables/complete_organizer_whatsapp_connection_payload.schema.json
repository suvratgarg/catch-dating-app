    "authorizationCode": {"type": "string", "minLength": 20, "maxLength": 2048},
    "wabaId": {"type": "string", "pattern": "^[0-9]{5,40}$"},
    "phoneNumberId": {"type": "string", "pattern": "^[0-9]{5,40}$"},
    "businessId": {"type": "string", "pattern": "^[0-9]{5,40}$"}
  }
}
