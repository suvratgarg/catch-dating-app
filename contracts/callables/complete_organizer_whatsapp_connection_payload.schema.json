{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/complete_organizer_whatsapp_connection_payload.schema.json",
  "title": "CompleteOrganizerWhatsappConnectionCallablePayload",
