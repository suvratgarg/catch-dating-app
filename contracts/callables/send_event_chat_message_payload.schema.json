{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/send_event_chat_message_payload.schema.json",
  "title": "SendEventChatMessageCallablePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "requestId",
    "text",
    "replyToMessageId",
    "expectedUid"
  ],
  "properties": {
    "eventId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "requestId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "replyToMessageId": {
      "anyOf": [
        {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedUid": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    }
  }
}
