  "title": "ListParticipantFormProfilesCallablePayload",
  "description": "List only the verified participant\u2019s active form profile proposals and private cards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cursor",
    "limit"
  ],
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        {
          "type": "null"
