{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/list_organizer_forms_payload.schema.json",
  "title": "ListOrganizerFormsCallablePayload",
  "description": "Lists bounded organizer form summaries using an opaque cursor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "statuses", "purposes", "query", "cursor", "limit"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "statuses": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "../shared/organizer_form_common.schema.json#/definitions/formLifecycleStatus"}},
    "purposes": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "../shared/organizer_form_common.schema.json#/definitions/formPurpose"}},
    "query": {"type": ["string", "null"], "maxLength": 120},
    "cursor": {"type": ["string", "null"], "maxLength": 500},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}
