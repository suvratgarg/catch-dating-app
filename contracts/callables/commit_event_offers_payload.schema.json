{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/commit_event_offers_payload.schema.json",
  "title": "CommitEventOffersCallablePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizerId",
    "eventId",
    "mode",
    "rows",
    "requestId",
    "planDigest"
  ],
  "properties": {
    "organizerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9_-]{1,180}$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9_-]{1,180}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "draft",
        "offer"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "../embedded/event_offer_row.schema.json"
      }
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,99}$"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
