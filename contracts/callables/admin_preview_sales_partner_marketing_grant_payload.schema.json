{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/admin_preview_sales_partner_marketing_grant_payload.schema.json",
  "title": "AdminPreviewSalesPartnerMarketingGrantCallablePayload",
  "x-callable-aliases": [
    "adminPreviewSalesPartnerMarketingGrant"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partnerUid",
    "organizerId",
    "campaignId",
    "channel",
    "assetIds"
  ],
  "properties": {
    "partnerUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "organizerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "campaignId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "other"
      ]
    },
    "assetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    }
  }
}
