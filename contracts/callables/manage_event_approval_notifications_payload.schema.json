{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callables/manage_event_approval_notifications_payload.schema.json",
  "title": "ManageEventApprovalNotificationsCallablePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "action",
    "expectedUid"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action": {
      "type": "string",
      "enum": [
        "get",
        "save"
      ]
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phoneUpdates",
        "emailUpdates"
      ],
      "properties": {
        "phoneUpdates": {
          "type": "boolean"
        },
        "emailUpdates": {
          "type": "boolean"
        }
      }
    },
    "termsVersion": {
      "type": "string",
      "const": "event-approval-v1"
    },
    "expectedUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "x-callable-aliases": [
    "manageEventApprovalNotifications"
  ]
}
