{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/participant_organizer_data_grants.schema.json",
  "title": "ParticipantOrganizerDataGrantDocument",
  "description": "Immutable consent receipt granting one organizer access to exact submitted fields for one application.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "participantOrganizerDataGrants",
  "x-firestore-path": "participantOrganizerDataGrants/{grantId}",
  "x-document-id-field": "grantId",
  "x-owner": "organizer application submission and grant revocation callables",
  "required": ["participantUid", "organizerId", "applicationId", "responseId", "formVersionId", "grantedQuestionIds", "grantedCanonicalFieldIds", "consentVersion", "consentCopyHash", "grantedAt", "revokedAt"],
  "properties": {
    "participantUid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "applicationId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "responseId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "formVersionId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "grantedQuestionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "grantedCanonicalFieldIds": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"$ref": "../shared/organizer_application_common.schema.json#/definitions/canonicalFieldId"}
    },
    "consentVersion": {"type": "string", "minLength": 1, "maxLength": 80},
    "consentCopyHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "grantedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "revokedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"}
  }
}
