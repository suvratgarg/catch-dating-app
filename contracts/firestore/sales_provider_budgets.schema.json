{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/sales_provider_budgets.schema.json",
  "title": "SalesProviderBudgetDocument",
  "description": "Private aggregate provider run/month accounting. Limits are immutable for each bucket; unknown attempts retain ceilings. Reserved cost is not actual billed cost. Retained hashes/counters contain no prompt, output, actor/contact/organizer identifiers.",
  "x-firestore-collection": "salesProviderBudgets",
  "x-firestore-path": "salesProviderBudgets/{bucketId}",
  "x-document-id-field": "bucketId",
  "x-owner": "disabled internal Sales writing preparation accounting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "classification",
    "bucketId",
    "kind",
    "scopeHash",
    "month",
    "limitsHash",
    "limits",
    "consumed",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "classification": {
      "const": "sales_private"
    },
    "bucketId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {
      "enum": [
        "run",
        "month"
      ]
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "month": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelCalls",
        "networkRequests",
        "modelInputTokens",
        "modelOutputTokens",
        "modelCostMicros"
      ],
      "properties": {
        "modelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "networkRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "modelInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "modelOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "modelCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "consumed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelCalls",
        "networkRequests",
        "modelInputTokens",
        "modelOutputTokens",
        "modelCostMicros"
      ],
      "properties": {
        "modelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "networkRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "modelInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "modelOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "modelCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
