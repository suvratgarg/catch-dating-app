{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_form_versions.schema.json",
  "title": "OrganizerFormVersionDocument",
  "description": "Immutable published definition of one generic organizer form version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "formId", "version", "sourceDraftRevision", "definition", "createdByUid", "createdAt", "publishedAt"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "formId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "sourceDraftRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "definition": {"$ref": "../shared/organizer_form_common.schema.json#/definitions/formDefinition"},
    "createdByUid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "publishedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"}
  },
  "x-firestore-collection": "organizerFormVersions",
  "x-firestore-path": "organizerFormVersions/{versionId}",
  "x-document-id-field": "versionId",
  "x-owner": "organizer form publish callable"
}
