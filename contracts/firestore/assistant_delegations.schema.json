{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/assistant_delegations.schema.json",
  "title": "AssistantDelegationDocument",
  "description": "Private expiring action and entity grant from an employee to one registered assistant client.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "classification", "delegationId", "actorUid", "clientId", "allowedActions", "organizerIds", "fieldIds", "expiresAt", "maxRequestsPerMinute", "maxRequestsPerDay", "revoked", "revision", "issuedByUid", "issuedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "classification": {"const": "sales_private"},
    "delegationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$"},
    "actorUid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$"},
    "clientId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$"},
    "allowedActions": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "enum": ["hosts.search", "hosts.get", "tasks.list", "opportunities.list", "fields.list", "receipts.get", "activities.log", "tasks.upsert", "opportunities.upsert", "fields.create", "fields.setValue"]}},
    "organizerIds": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$"}},
    "fieldIds": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "maxLength": 96, "pattern": "^sales\\.[A-Za-z0-9._:-]+$"}},
    "expiresAt": {"type": "string", "format": "date-time"},
    "maxRequestsPerMinute": {"type": "integer", "minimum": 1, "maximum": 60},
    "maxRequestsPerDay": {"type": "integer", "minimum": 1, "maximum": 1000},
    "revoked": {"type": "boolean"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "issuedByUid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "revokedByUid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,128}$"},
    "revokedAt": {"type": "string", "format": "date-time"}
  },
  "x-firestore-collection": "assistantDelegations",
  "x-firestore-path": "assistantDelegations/{delegationId}",
  "x-document-id-field": "delegationId",
  "x-owner": "sales assistant gateway server-only management"
}
