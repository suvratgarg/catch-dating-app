{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_form_response_drafts.schema.json",
  "title": "OrganizerFormResponseDraftDocument",
  "description": "Expiring version-bound respondent autosave state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "formId", "versionId", "publicFormId", "status", "revision", "identityKind", "respondentUid", "draftTokenHash", "answers", "consentAccepted", "consentVersion", "sourceLinkId", "createdAt", "updatedAt", "expiresAt", "submittedResponseId"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "formId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "versionId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "publicFormId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{20,80}$"},
    "status": {"$ref": "../shared/organizer_form_response_common.schema.json#/definitions/draftStatus"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "identityKind": {"$ref": "../shared/organizer_form_response_common.schema.json#/definitions/responseIdentityKind"},
    "respondentUid": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}]},
    "draftTokenHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "answers": {"$ref": "../shared/organizer_form_response_common.schema.json#/definitions/answerMap"},
    "consentAccepted": {"type": "boolean"},
    "consentVersion": {"type": "string", "minLength": 1, "maxLength": 80},
    "sourceLinkId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}]},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "expiresAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "submittedResponseId": {"anyOf": [{"$ref": "../shared/event_common.schema.json#/definitions/documentId"}, {"type": "null"}]}
  },
  "x-firestore-collection": "organizerFormResponseDrafts",
  "x-firestore-path": "organizerFormResponseDrafts/{draftId}",
  "x-document-id-field": "draftId",
  "x-owner": "organizer form respondent callables"
}
