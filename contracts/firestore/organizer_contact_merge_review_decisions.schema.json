{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_contact_merge_review_decisions.schema.json",
  "title": "OrganizerContactMergeReviewDecisionDocument",
  "description": "Latest manager decision for one deterministic organizer-contact candidate pair. A different-people decision suppresses the pair until the same manager reopens it.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "organizerContactMergeReviewDecisions",
  "x-firestore-path": "organizerContactMergeReviewDecisions/{decisionId}",
  "x-document-id-field": "decisionId",
  "x-owner": "organizer contact merge review callable",
  "required": [
    "schemaVersion", "decisionId", "organizerId", "contactIds", "state",
    "reviewedByUid", "reviewedAt", "reopenedByUid", "reopenedAt",
    "revision", "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "decisionId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "contactIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"}
    },
    "state": {"type": "string", "enum": ["differentPeople", "reopened"]},
    "reviewedByUid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "reviewedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "reopenedByUid": {
      "anyOf": [
        {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        {"type": "null"}
      ]
    },
    "reopenedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"}
  }
}
