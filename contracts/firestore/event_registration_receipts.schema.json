{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/event_registration_receipts.schema.json",
  "title": "EventRegistrationReceiptDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizerId",
    "eventId",
    "actorUid",
    "requestHash",
    "registrationRevision",
    "mode",
    "createdAt"
  ],
  "properties": {
    "organizerId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "eventId": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "actorUid": {
      "$ref": "../shared/event_common.schema.json#/definitions/documentId"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registrationRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "mode": {
      "enum": [
        "closed",
        "free",
        "paid"
      ]
    },
    "createdAt": {
      "$ref": "../shared/event_common.schema.json#/definitions/timestamp"
    }
  },
  "x-firestore-collection": "eventRegistrationReceipts",
  "x-firestore-path": "eventRegistrationReceipts/{receiptId}",
  "x-document-id-field": "receiptId",
  "x-owner": "explicit event registration configuration service"
}
