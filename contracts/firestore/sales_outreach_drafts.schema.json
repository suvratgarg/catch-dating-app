{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/sales_outreach_drafts.schema.json",
  "title": "SalesOutreachDraftDocument",
  "description": "Private Operations-rendered manual-copy-only draft with frozen source request and exact source hash.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "salesOutreachDrafts",
  "x-firestore-path": "salesOutreachDrafts/{draftId}",
  "x-document-id-field": "draftId",
  "x-owner": "private Sales intelligence Operations bridge",
  "required": [
    "schemaVersion",
    "classification",
    "draftId",
    "organizerId",
    "contactId",
    "opportunityId",
    "sourceRequest",
    "sourceMaterialHash",
    "sourceHash",
    "inputHash",
    "draft",
    "status",
    "createdAt",
    "createdBy",
    "reviewedAt",
    "reviewedBy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "classification": {
      "const": "sales_private"
    },
    "draftId": {
      "$ref": "#/definitions/id"
    },
    "organizerId": {
      "$ref": "#/definitions/id"
    },
    "contactId": {
      "$ref": "#/definitions/id"
    },
    "opportunityId": {
      "$ref": "#/definitions/id"
    },
    "sourceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizerId",
        "contactId",
        "opportunityId",
        "observationIds",
        "capabilityIds",
        "referenceIds",
        "ctaIds",
        "channel",
        "purpose"
      ],
      "properties": {
        "organizerId": {
          "$ref": "#/definitions/id"
        },
        "contactId": {
          "$ref": "#/definitions/id"
        },
        "opportunityId": {
          "$ref": "#/definitions/id"
        },
        "observationIds": {
          "$ref": "#/definitions/ids"
        },
        "capabilityIds": {
          "$ref": "#/definitions/ids"
        },
        "referenceIds": {
          "$ref": "#/definitions/ids"
        },
        "ctaIds": {
          "$ref": "#/definitions/ids"
        },
        "channel": {
          "enum": [
            "email",
            "message"
          ]
        },
        "purpose": {
          "enum": [
            "first_message",
            "follow_up"
          ]
        },
        "priorActivityId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "sourceMaterialHash": {
      "$ref": "#/definitions/hash"
    },
    "sourceHash": {
      "$ref": "#/definitions/hash"
    },
    "inputHash": {
      "$ref": "#/definitions/hash"
    },
    "draft": {
      "$ref": "../operations/outreach_drafting_draft.schema.json"
    },
    "status": {
      "enum": [
        "pending_review",
        "approved"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "$ref": "#/definitions/id"
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewedBy": {
      "anyOf": [
        {
          "$ref": "#/definitions/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "participantScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partnerUid",
        "assignmentRevision",
        "renderedDraftId"
      ],
      "properties": {
        "partnerUid": {
          "$ref": "#/definitions/id"
        },
        "assignmentRevision": {
          "type": "integer",
          "minimum": 1
        },
        "renderedDraftId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revision",
        "previousRevision",
        "baseContentHash",
        "previousContentHash",
        "contentHash",
        "editRequestId",
        "editedAt",
        "editedBy",
        "style"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "previousRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "baseContentHash": {
          "$ref": "#/definitions/hash"
        },
        "previousContentHash": {
          "$ref": "#/definitions/hash"
        },
        "contentHash": {
          "$ref": "#/definitions/hash"
        },
        "editRequestId": {
          "$ref": "#/definitions/id"
        },
        "editedAt": {
          "type": "string",
          "format": "date-time"
        },
        "editedBy": {
          "$ref": "#/definitions/id"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "greeting",
            "closing",
            "subjectStyle",
            "paragraphStyle"
          ],
          "properties": {
            "greeting": {
              "enum": [
                "none",
                "hello",
                "hi"
              ]
            },
            "closing": {
              "enum": [
                "none",
                "thanks",
                "best"
              ]
            },
            "subjectStyle": {
              "enum": [
                "original",
                "question",
                "idea"
              ]
            },
            "paragraphStyle": {
              "enum": [
                "spaced",
                "compact"
              ]
            }
          }
        }
      },
      "description": "Own-partner neutral style edit, bound to an immutable intelligence receipt; never replaces sourced factual prose."
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ids": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id"
      }
    }
  }
}
