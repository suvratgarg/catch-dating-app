{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/sales_fit_queue_receipts.schema.json",
  "title": "SalesFitQueueReceiptDocument",
  "description": "Private exact-retry receipt for one host fit projection refresh, not a durable claim of current rank.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "salesFitQueueReceipts",
  "x-firestore-path": "salesFitQueueReceipts/{receiptId}",
  "x-document-id-field": "receiptId",
  "x-owner": "private Sales fit queue refresh callable",
  "required": [
    "schemaVersion",
    "classification",
    "receiptId",
    "actorUid",
    "requestId",
    "materialHash",
    "result",
    "createdAt",
    "qualificationPolicyHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "classification": {
      "const": "sales_private"
    },
    "receiptId": {
      "$ref": "#/definitions/id"
    },
    "actorUid": {
      "$ref": "#/definitions/id"
    },
    "requestId": {
      "$ref": "#/definitions/id"
    },
    "materialHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "$ref": "../callable_responses/admin_sales_fit_queue_refresh_response.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "qualificationPolicyHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
