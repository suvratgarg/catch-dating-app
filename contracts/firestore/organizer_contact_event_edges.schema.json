{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/organizer_contact_event_edges.schema.json",
  "title": "OrganizerContactEventEdgeDocument",
  "description": "Rebuildable organizer-person-event fact edge projected from the canonical operational attendee.",
  "type": "object",
  "additionalProperties": false,
  "x-firestore-collection": "organizerContactEventEdges",
  "x-firestore-path": "organizerContactEventEdges/{edgeId}",
  "x-document-id-field": "edgeId",
  "x-owner": "organizer audience projection",
  "required": [
    "organizerId", "contactId", "originContactId", "eventId", "attendeeId", "displayName",
    "linkedUid", "phoneE164", "email", "source", "status", "expected",
    "registered", "cancelled", "checkedIn", "eventStartAt", "eventEndAt",
    "registeredAt", "cancelledAt", "checkedInAt", "sourceCreatedAt",
    "sourceUpdatedAt", "revision", "createdAt", "updatedAt"
  ],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "contactId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "originContactId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "attendeeId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
    "linkedUid": {"type": ["string", "null"], "minLength": 1, "maxLength": 180},
    "phoneE164": {"type": ["string", "null"], "pattern": "^\\+[1-9][0-9]{7,14}$"},
    "email": {"type": ["string", "null"], "format": "email", "maxLength": 320},
    "source": {"type": "string", "enum": ["catchBooking", "hostImport", "hostManual", "webOtp"]},
    "status": {"type": "string", "enum": ["invited", "registered", "waitlisted", "checkedIn", "cancelled"]},
    "expected": {"type": "boolean"},
    "registered": {"type": "boolean"},
    "cancelled": {"type": "boolean"},
    "checkedIn": {"type": "boolean"},
    "eventStartAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "eventEndAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "registeredAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "cancelledAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "checkedInAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "inviteLinkId": {"type": ["string", "null"], "minLength": 1, "maxLength": 180},
    "inviteCapturedAt": {"$ref": "../shared/event_common.schema.json#/definitions/nullableTimestamp"},
    "sourceCreatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "sourceUpdatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "createdAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"},
    "updatedAt": {"$ref": "../shared/event_common.schema.json#/definitions/timestamp"}
  }
}
