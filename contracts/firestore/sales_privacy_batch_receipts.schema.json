{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/firestore/sales_privacy_batch_receipts.schema.json",
  "title": "SalesPrivacyBatchReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "classification", "receiptId", "organizerId", "planId", "expectedCursor", "requestId", "result", "createdAt", "actorUid"],
  "properties": {
    "schemaVersion": {"const": 1},
    "classification": {"const": "sales_private"},
    "receiptId": {"type": "string", "pattern": "^privacy-batch-[a-f0-9]{40}$"},
    "organizerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,179}$"},
    "planId": {"type": "string", "pattern": "^privacy-[a-f0-9]{40}$"},
    "expectedCursor": {"type": "integer", "minimum": 0, "maximum": 240},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$"},
    "result": {"$ref": "../callable_responses/admin_apply_sales_privacy_batch_response.schema.json#/properties/batch"},
    "createdAt": {"type": "string", "format": "date-time"},
    "actorUid": {"type": "string", "minLength": 1}
  }
}
