{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/respond_cross_paths_invitation_response.schema.json",
  "title": "RespondCrossPathsInvitationCallableResponse",
  "description": "Sanitized terminal response after accepting or declining an invitation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["invitationId", "status", "conversationId", "pairHoldId"],
  "properties": {
    "invitationId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "status": {"type": "string", "enum": ["accepted", "declined"]},
    "conversationId": {
      "anyOf": [
        {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        {"type": "null"}
      ]
    },
    "pairHoldId": {
      "anyOf": [
        {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        {"type": "null"}
      ]
    }
  }
}
