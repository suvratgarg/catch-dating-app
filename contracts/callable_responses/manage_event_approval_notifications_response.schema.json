{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/manage_event_approval_notifications_response.schema.json",
  "title": "ManageEventApprovalNotificationsCallableResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "revision",
    "choices",
    "phoneVerified",
    "emailVerified",
    "available",
    "terms"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phoneUpdates",
        "emailUpdates"
      ],
      "properties": {
        "phoneUpdates": {
          "type": "boolean"
        },
        "emailUpdates": {
          "type": "boolean"
        }
      }
    },
    "phoneVerified": {
      "type": "boolean"
    },
    "emailVerified": {
      "type": "boolean"
    },
    "available": {
      "type": "boolean"
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "phone",
        "email"
      ],
      "properties": {
        "version": {
          "type": "string",
          "const": "event-approval-v1"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    }
  }
}
