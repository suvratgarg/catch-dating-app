{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "title": "AdminGetSalesFunnelReportResponse",
  "required": [
    "activeHosts",
    "opportunities",
    "hostsWithOpportunities",
    "overdueOpportunities",
    "hostsWithOverdueOpportunities",
    "opportunitiesMissingNextStep",
    "openObligations",
    "overdueObligations",
    "heldHosts",
    "duplicateReviewHosts",
    "excludedArchivedOrRestrictedHosts",
    "movementEvents",
    "schemaVersion",
    "asOf",
    "since",
    "coverage",
    "revenueStatus",
    "stages"
  ],
  "properties": {
    "activeHosts": {
      "type": "integer",
      "minimum": 0
    },
    "opportunities": {
      "type": "integer",
      "minimum": 0
    },
    "hostsWithOpportunities": {
      "type": "integer",
      "minimum": 0
    },
    "overdueOpportunities": {
      "type": "integer",
      "minimum": 0
    },
    "hostsWithOverdueOpportunities": {
      "type": "integer",
      "minimum": 0
    },
    "opportunitiesMissingNextStep": {
      "type": "integer",
      "minimum": 0
    },
    "openObligations": {
      "type": "integer",
      "minimum": 0
    },
    "overdueObligations": {
      "type": "integer",
      "minimum": 0
    },
    "heldHosts": {
      "type": "integer",
      "minimum": 0
    },
    "duplicateReviewHosts": {
      "type": "integer",
      "minimum": 0
    },
    "excludedArchivedOrRestrictedHosts": {
      "type": "integer",
      "minimum": 0
    },
    "movementEvents": {
      "type": "integer",
      "minimum": 0
    },
    "schemaVersion": {
      "const": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "const": "complete_bounded_snapshot"
    },
    "revenueStatus": {
      "const": "not_calculated"
    },
    "stages": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "opportunities",
          "distinctHosts",
          "enteredInWindow",
          "distinctHostsEntered"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "new_enquiry",
              "ready_to_contact",
              "contacted",
              "in_conversation",
              "demo_arranged",
              "demo_completed",
              "pilot_agreed",
              "pilot_running",
              "commercial_discussion",
              "closed_won",
              "closed_lost"
            ]
          },
          "opportunities": {
            "type": "integer",
            "minimum": 0
          },
          "distinctHosts": {
            "type": "integer",
            "minimum": 0
          },
          "enteredInWindow": {
            "type": "integer",
            "minimum": 0
          },
          "distinctHostsEntered": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
