{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/mutate_organizer_contact_response.schema.json",
  "title": "MutateOrganizerContactCallableResponse",
  "description": "Safe state returned after an organizer-scoped contact mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "contactId", "displayName", "displayNameOverride", "whatsappAdminSuppressed", "hidden", "revision"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "contactId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
    "displayNameOverride": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "whatsappAdminSuppressed": {"type": "boolean"},
    "hidden": {"type": "boolean"},
    "manualTags": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"$ref": "get_organizer_contact_detail_response.schema.json#/definitions/manualTag"}},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
