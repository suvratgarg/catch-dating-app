{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/claim_participant_form_profile_response.schema.json",
  "title": "ClaimParticipantFormProfileCallableResponse",
  "description": "Private claim result. No public or room sharing is inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileRevision",
    "organizerCardId",
    "claimedAtMillis",
    "replayed"
  ],
  "properties": {
    "profileRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "organizerCardId": {
      "anyOf": [
        {
          "$ref": "../shared/event_common.schema.json#/definitions/documentId"
        },
        {
          "type": "null"
        }
      ]
    },
    "claimedAtMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
