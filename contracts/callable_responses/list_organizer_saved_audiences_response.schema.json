{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/list_organizer_saved_audiences_response.schema.json",
  "title": "ListOrganizerSavedAudiencesCallableResponse",
  "description": "One bounded page of reusable organizer CRM audiences.",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizerId", "audiences", "nextCursor"],
  "properties": {
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "audiences": {"type": "array", "maxItems": 50, "items": {"$ref": "organizer_saved_audience_response.schema.json"}},
    "nextCursor": {"type": ["string", "null"], "maxLength": 1000},
    "filterOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forms",
        "questions",
        "events",
        "tags"
      ],
      "properties": {
        "forms": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "formId",
              "title"
            ],
            "properties": {
              "formId": {
                "$ref": "../shared/event_common.schema.json#/definitions/documentId"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "formId",
              "versionId",
              "version",
              "formTitle",
              "questionId",
              "label",
              "kind",
              "options"
            ],
            "properties": {
              "formId": {
                "$ref": "../shared/event_common.schema.json#/definitions/documentId"
              },
              "versionId": {
                "$ref": "../shared/event_common.schema.json#/definitions/documentId"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "formTitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "questionId": {
                "$ref": "../shared/event_common.schema.json#/definitions/documentId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "kind": {
                "type": "string",
                "enum": [
                  "singleChoice",
                  "multiChoice",
                  "boolean"
                ]
              },
              "options": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "value"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "value": {
                      "type": [
                        "string",
                        "boolean"
                      ],
                      "minLength": 1,
                      "maxLength": 160
                    }
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eventId",
              "title"
            ],
            "properties": {
              "eventId": {
                "$ref": "../shared/event_common.schema.json#/definitions/documentId"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tagId",
              "label"
            ],
            "properties": {
              "tagId": {
                "$ref": "../shared/event_common.schema.json#/definitions/documentId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        }
      }
    }
  }
}
