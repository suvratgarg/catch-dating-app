{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/get_cross_paths_suggestions_response.schema.json",
  "title": "GetCrossPathsSuggestionsCallableResponse",
  "description": "Roster-private Cross Paths suggestions. The response contains only sanitized person and event projections plus a short-lived server-signed token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rankingVersion", "suggestions"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "rankingVersion": {"type": "integer", "const": 1},
    "suggestions": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/definitions/suggestion"}
    }
  },
  "definitions": {
    "reasonCode": {
      "type": "string",
      "enum": [
        "attending_event",
        "viewer_attending",
        "booking_available",
        "mutual_preferences",
        "showcase_ready"
      ]
    },
    "promptAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "answer"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1, "maxLength": 140},
        "answer": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "name", "age", "gender", "city", "photoUrls", "promptAnswers", "relationshipGoal"],
      "properties": {
        "uid": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "age": {"type": "integer", "minimum": 18, "maximum": 99},
        "gender": {"$ref": "../shared/profile_common.schema.json#/definitions/gender"},
        "city": {
          "anyOf": [
            {"$ref": "../shared/profile_common.schema.json#/definitions/marketId"},
            {"type": "null"}
          ]
        },
        "photoUrls": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {"type": "string", "format": "uri", "maxLength": 2048}
        },
        "promptAnswers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/definitions/promptAnswer"}
        },
        "relationshipGoal": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "organizerId", "startTime", "endTime", "meetingPoint", "activityKind", "photoUrl", "viewerBookingStatus"],
      "properties": {
        "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
        "organizerId": {
          "anyOf": [
            {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
            {"type": "null"}
          ]
        },
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"},
        "meetingPoint": {"type": "string", "minLength": 1, "maxLength": 240},
        "activityKind": {"$ref": "../shared/event_common.schema.json#/definitions/activityKind"},
        "photoUrl": {"type": ["string", "null"], "format": "uri", "maxLength": 2048},
        "viewerBookingStatus": {"type": "string", "enum": ["signedUp", "canBookNow"]}
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["person", "event", "reasonCodes", "suggestionToken", "tokenExpiresAt"],
      "properties": {
        "person": {"$ref": "#/definitions/person"},
        "event": {"$ref": "#/definitions/event"},
        "reasonCodes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/reasonCode"}
        },
        "suggestionToken": {"type": "string", "minLength": 40, "maxLength": 4096},
        "tokenExpiresAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
