{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/admin_sales_outreach_copy_response.schema.json",
  "title": "AdminCopySalesOutreachDraftResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draftId",
    "subject",
    "text",
    "exactContentHash",
    "copiedAt",
    "sendAuthority",
    "providerConfirmed"
  ],
  "properties": {
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "subject": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "exactContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "copiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sendAuthority": {
      "const": false
    },
    "providerConfirmed": {
      "const": false
    }
  },
  "x-callable-aliases": [
    "adminCopySalesOutreachDraft"
  ]
}
