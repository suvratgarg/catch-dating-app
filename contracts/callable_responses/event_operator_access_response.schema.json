{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/callable_responses/event_operator_access_response.schema.json",
  "title": "EventOperatorAccessCallableResponse",
  "description": "Sanitized event facts and exact operator permissions. No organizer-wide data is exposed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "organizerId", "title", "startAtMillis", "endAtMillis", "eventStatus", "actorRole", "permissions", "grantExpiresAtMillis"],
  "properties": {
    "eventId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "organizerId": {"$ref": "../shared/event_common.schema.json#/definitions/documentId"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "startAtMillis": {"type": "integer", "minimum": 0},
    "endAtMillis": {"type": "integer", "minimum": 0},
    "eventStatus": {"type": "string", "enum": ["active", "cancelled"]},
    "actorRole": {"type": "string", "enum": ["manager", "operator"]},
    "permissions": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["viewRoster", "setAttendance", "reviewRuntimeClaims"]}},
    "grantExpiresAtMillis": {"type": ["integer", "null"], "minimum": 0}
  }
}
