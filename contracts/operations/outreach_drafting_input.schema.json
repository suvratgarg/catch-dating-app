{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/operations/outreach_drafting_input.schema.json",
  "title": "OutreachDraftingInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "organizer",
    "contact",
    "opportunity",
    "language",
    "channel",
    "purpose",
    "evaluatedAt",
    "policy",
    "observations",
    "capabilities",
    "references",
    "ctas",
    "priorInteraction",
    "evidenceConflictStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizer": {
      "$ref": "#/definitions/organizer"
    },
    "contact": {
      "$ref": "#/definitions/contact"
    },
    "opportunity": {
      "$ref": "#/definitions/opportunity"
    },
    "language": {
      "type": "string",
      "enum": [
        "en"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "message"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "first_message",
        "follow_up"
      ]
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptVersion",
        "playbookVersion",
        "modelId"
      ],
      "properties": {
        "promptVersion": {
          "$ref": "#/definitions/id"
        },
        "playbookVersion": {
          "$ref": "#/definitions/id"
        },
        "modelId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/clause"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/clause"
      }
    },
    "references": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/clause"
      }
    },
    "ctas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "revision"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "text": {
            "$ref": "#/definitions/text"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "priorInteraction": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activityId",
            "summary",
            "revision"
          ],
          "properties": {
            "activityId": {
              "$ref": "#/definitions/id"
            },
            "summary": {
              "$ref": "#/definitions/text"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "evidenceConflictStatus": {
      "enum": [
        "clear",
        "needs_review"
      ]
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "organizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizerId",
        "name",
        "revision",
        "identityStatus"
      ],
      "properties": {
        "organizerId": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "identityStatus": {
          "const": "verified"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contactId",
        "revision",
        "role",
        "eligibility",
        "suppressionStatus",
        "claimStatus"
      ],
      "properties": {
        "contactId": {
          "$ref": "#/definitions/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "$ref": "#/definitions/text"
        },
        "eligibility": {
          "const": "eligible"
        },
        "suppressionStatus": {
          "const": "clear"
        },
        "claimStatus": {
          "enum": [
            "verified",
            "not_required"
          ]
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunityId",
        "revision",
        "stage",
        "motion"
      ],
      "properties": {
        "opportunityId": {
          "$ref": "#/definitions/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "$ref": "#/definitions/id"
        },
        "motion": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "revision",
        "organizerId",
        "approved",
        "validUntil"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "text": {
          "$ref": "#/definitions/text"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "organizerId": {
          "$ref": "#/definitions/id"
        },
        "approved": {
          "const": true
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
