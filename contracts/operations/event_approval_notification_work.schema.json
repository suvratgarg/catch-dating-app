{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://catch.app/contracts/operations/event_approval_notification_work.schema.json",
  "title": "EventApprovalNotificationWork",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "messageId",
    "intentHash",
    "dueAt",
    "evaluations",
    "failures",
    "lastMessageRevision"
  ],
  "properties": {
    "kind": {
      "const": "approvalNotification",
      "type": "string"
    },
    "messageId": {
      "type": "string",
      "pattern": "^outbox:[a-f0-9]{64}$"
    },
    "intentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dueAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evaluations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "lastMessageRevision": {
      "type": "integer",
      "minimum": -1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
